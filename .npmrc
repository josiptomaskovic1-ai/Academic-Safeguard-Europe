# Supply-chain hardening: never run package install/postinstall scripts. The site builds without them
# (esbuild resolves its platform binary from optionalDependencies; sharp is optional and unused).
# `npm run <script>` for this project's own scripts is unaffected.
ignore-scripts=true
# Only fetch packages from the public npm registry over HTTPS.
registry=https://registry.npmjs.org/
