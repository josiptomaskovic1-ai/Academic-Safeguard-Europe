---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Folio from '../components/Folio.astro';
import ScopeIcon from '../components/ScopeIcon.astro';
import IconList from '../components/IconList.astro';
import WorkflowDiagram from '../components/WorkflowDiagram.astro';
import { getCorrections } from '../lib/data';
import { newIssue, repoFile, CONTACT_EMAIL } from '../lib/url';
const corrections = [...getCorrections()].sort((a, b) => b.received.localeCompare(a.received));
const TYPE: Record<string, string> = { factual_correction: 'Factual correction', methodology_disagreement: 'Disagreement with methodology', new_source: 'New or newer source', broken_link: 'Broken link' };
const STATUS: Record<string, string> = { open: 'Open', under_review: 'Under review', accepted: 'Accepted', partially_accepted: 'Partially accepted', not_accepted: 'Not accepted' };

// V7: the five stages of a correction request. Icons follow the 24×24 line family.
const steps = [
  { title: 'Logged', text: 'Public ID, e.g. C-2026-001' },
  { title: 'Marked disputed', text: 'Shown next to the finding' },
  { title: 'Independent review', text: 'By someone who did not make the finding' },
  { title: 'Reasoned outcome', text: 'Written reasons, public commit' },
  { title: 'Kept in history', text: 'Nothing silently overwritten' },
];
const stepIcons = [
  '<path d="M6.5 3h12v18h-12z"/><path d="M9.5 7.5h6M9.5 11h6M9.5 14.5h3.5"/><path d="M4 6.5h2.5M4 10.5h2.5M4 14.5h2.5"/>',
  '<path d="M5.5 21V3.5"/><path d="M5.5 4.5h12.5l-2.75 4 2.75 4H5.5"/>',
  '<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="2.75"/>',
  '<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4"/><path d="M8.5 9h3.5M8.5 12h7M8.5 15h4"/><circle cx="14.25" cy="18" r="1.5"/>',
  '<path d="M3.5 12a8.5 8.5 0 1 0 2.5-6"/><path d="M3.5 3v4h4"/><path d="M12 7.5V12l3 2"/>',
];
const doNot = [
  { icon: 'individuals', text: 'Names of staff or students' },
  { icon: 'allegations', text: 'Allegations or complaint files' },
  { icon: 'correspondence', text: 'Health information or private correspondence' },
];
---
<Base title="Corrections and right of reply" description="How universities, researchers and others can correct or challenge ASE findings." campaign>
  <PageHero crumbs={[{ label: 'Evidence', href: '/evidence/' }, { label: 'Corrections' }]} kicker="Evidence · Corrections">
    Corrections and right of reply
    <Fragment slot="lede">Any finding can be challenged: missing policies, newer versions, broken links, misreadings or disagreements with the method.</Fragment>
  </PageHero>

  <section class="sec--dense" aria-label="Choose a route">
    <div class="container">
      <Folio label="Choose a route" dense />
      <div class="route-grid">
        <section class="route-card" aria-labelledby="fact">
          <h2 id="fact">Factual correction</h2>
          <p>We applied the rubric wrongly or missed a document. If accepted, the finding changes.</p>
          <details class="disclosure">
            <summary>Examples</summary>
            <ul class="small">
              <li>a policy or regulation exists that we did not review;</li>
              <li>a newer version replaces the document we cited;</li>
              <li>we misread or mistranslated a provision;</li>
              <li>a link is broken or points to the wrong document.</li>
            </ul>
          </details>
          <p class="route-action"><a class="btn btn-primary" href={newIssue('correction.yml', '[Correction] ')}>Open the correction form on GitHub</a></p>
        </section>
        <section class="route-card" aria-labelledby="method">
          <h2 id="method">Methodology disagreement</h2>
          <p>The rubric itself is wrong. Recorded publicly for the next version; current findings stay.</p>
          <details class="disclosure">
            <summary>More about disagreements</summary>
            <p class="small">Use this route if you accept that we applied the rubric correctly but think the rubric itself is wrong. For example, a safeguard should be defined differently, or a national system achieves the same protection another way. Disagreements are shown alongside the finding where relevant.</p>
          </details>
          <p class="route-action"><a class="btn btn-secondary" href={newIssue('methodology-proposal.yml', '[Methodology] ')}>Open the methodology form on GitHub</a></p>
        </section>
      </div>

      <section class="guide-block" aria-labelledby="github-guide">
        <h2 id="github-guide">New to GitHub? Here is what to expect</h2>
        <ol class="step-list">
          <li>Choose a factual correction or a methodology disagreement above.</li>
          <li>The button opens a structured GitHub form. Sign in, follow the prompts and submit it; a pseudonymous account works.</li>
          <li>The request, review and outcome remain public so changes can be audited.</li>
        </ol>
        <div class="statement statement--provisional">
          <p><strong>Do not submit personal data, names, allegations or case details.</strong> StudentSafe Europe reviews published evidence, not individual cases.</p>
          <p class="small">
            {CONTACT_EMAIL ? (
              <>Prefer a non-GitHub route? Write to <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. Only a neutral summary and request ID are logged publicly.</>
            ) : (
              <>StudentSafe Europe does not currently have a safe private submission route. GitHub is the only route; this is a known limitation.</>
            )}
          </p>
        </div>
      </section>
    </div>
  </section>

  <section class="sec--dense" aria-labelledby="process">
    <div class="container">
      <Folio label="Process" dense />
      <h2 id="process">What happens next</h2>
      <WorkflowDiagram steps={steps} icons={stepIcons} process label="Stages of a correction request" />
      <p class="caveat-line">
        <ScopeIcon name="correction" size="1.15rem" />
        <span>We aim to acknowledge within 10 working days. Nothing is silently overwritten.</span>
      </p>
      <details class="disclosure">
        <summary>Each step in detail</summary>
        <ol class="prose">
          <li><strong>Acknowledgement.</strong> The request is logged with an ID such as <code>C-2026-001</code>. We aim to acknowledge requests within 10 working days.</li>
          <li><strong>Disputed marking.</strong> If the request raises a substantive question, the affected finding is marked <em>disputed</em> and the dispute is shown publicly next to it. The finding is not removed.</li>
          <li><strong>Review.</strong> A reviewer who did not make the original finding checks the new evidence against the rubric.</li>
          <li><strong>Outcome.</strong> The request is accepted, partially accepted or not accepted, with written reasons. Any change to data is made in a public commit that references the correction ID.</li>
          <li><strong>Record.</strong> The earlier finding remains in the public history. Nothing is silently overwritten.</li>
        </ol>
      </details>
    </div>
  </section>

  <section class="sec--dense" aria-label="Right of reply and privacy">
    <div class="container">
      <Folio label="Reply and privacy" dense />
      <div class="split split--even">
        <div>
          <h2 id="reply">Right of reply</h2>
          <p class="reading reading--sm">Institutions may publish a reply of up to 300 words on their profile, whatever the outcome.</p>
        </div>
        <div>
          <h2 id="do-not">Please do not include</h2>
          <IconList items={doNot} tone="doesnot" />
          <p class="small muted donot-close">Requests are public. StudentSafe Europe cannot investigate individual cases.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec--dense" aria-labelledby="log">
    <div class="container">
      <Folio label="Log" dense />
      <h2 id="log">Public corrections log</h2>
      {corrections.length === 0 ? (
        <p class="muted sec-note">No correction requests have been received yet.</p>
      ) : (
        <div class="table-wrap" tabindex="0" role="region" aria-labelledby="log">
          <table>
            <thead><tr><th scope="col">ID</th><th scope="col">Received</th><th scope="col">Type</th><th scope="col">Record</th><th scope="col">Summary</th><th scope="col">Status</th></tr></thead>
            <tbody>
              {corrections.map((c) => (
                <tr id={c.id}><th scope="row"><code>{c.id}</code></th><td>{c.received}</td><td>{TYPE[c.type]}</td><td><code>{c.target}</code></td><td>{c.summary}{c.resolution && <><br /><span class="small muted">Resolution: {c.resolution}</span></>}</td><td>{STATUS[c.status]}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
      <p class="small muted">Log file: <a href={repoFile('data/corrections.yml')}><code>data/corrections.yml</code></a> · Full policy: <a href={repoFile('docs/correction-policy.md')}>correction-policy.md</a> · <a href={repoFile('docs/right-of-reply.md')}>right-of-reply.md</a></p>
    </div>
  </section>
</Base>
