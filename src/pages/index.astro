---
import Base from '../layouts/Base.astro';
import Marquee from '../components/Marquee.astro';
import { getCountries, getInstitutions, getRubric, hasFindings } from '../lib/data';
import { url } from '../lib/url';
import { CAMPAIGN_NAME, PRINCIPLES, DEMANDS, KEY_SENTENCE, KEY_SENTENCE_LEAD, KEY_SENTENCE_ACCENT, TRIAD } from '../lib/campaign';

const countries = getCountries();
const institutions = getInstitutions();
const researchedCountries = countries.filter((c) => hasFindings(c.safeguards));
const researchedInstitutions = institutions.filter((i) => hasFindings(i.safeguards));
const results = [...countries, ...institutions].flatMap((r) => Object.values(r.safeguards)).filter((r) => r.result !== 'NR');
const verified = results.filter((r) => r.verification === 'verified').length;
// Only disclose AI assistance as universal when every record with findings says so in its research_method.
const recordsWithFindings = [...researchedCountries, ...researchedInstitutions];
const allAiAssisted = recordsWithFindings.length > 0 && recordsWithFindings.every((r) => /\bAI\b/.test(r.research_method ?? ''));
// Institution names such as "University of Zagreb" read naturally with a leading article; the data stays unchanged.
const withArticle = (name: string) => (/^(University|Academy|Institute)\b/.test(name) ? `the ${name}` : name);
const pilotNames = [...researchedCountries.map((c) => c.name), ...researchedInstitutions.map((i) => withArticle(i.canonical_name))];
const safeguardCount = getRubric().safeguards.length;
const listFormat = new Intl.ListFormat('en', { style: 'long', type: 'conjunction' });

// Scope grid: one square per Member State in scope. Filled = research has started (any status other than
// "not yet researched"); outlined = not yet researched, which says nothing about whether safeguards exist.
const started = countries.filter((c) => c.research_status !== 'not_researched').sort((a, b) => a.name.localeCompare(b.name));
const notStarted = countries.filter((c) => c.research_status === 'not_researched');
const cells = [...started.map(() => true), ...notStarted.map(() => false)];
const startedNames = listFormat.format(started.map((c) => c.name));
const findingsLine = verified === 0
  ? `All findings are provisional${allAiAssisted ? ' and AI-assisted' : ''}.`
  : 'Findings not yet independently verified are marked provisional.';
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI'];
// Hero headline, split at build time for the word-by-word rise. The last word keeps
// the signal underline. HERO_SENTENCE is what assistive technology announces.
const HERO_SENTENCE = 'Academic power needs safeguards.';
// The problem statement, split at build time so each word can ink in on scroll.
// The full sentence stays in one visually-hidden span, so the h2 is announced once.
const STATEMENT_WORDS = KEY_SENTENCE_LEAD.trim().split(/\s+/);
const HERO_WORDS = [
  { text: 'Academic', bar: false },
  { text: 'power', bar: false },
  { text: 'needs', bar: false },
  { text: 'safeguards.', bar: true },
];
const [triadLead, triadLast] = [TRIAD.slice(0, -1), TRIAD[TRIAD.length - 1]];
---
<Base title="Home" campaign>
  <section class="m-hero on-navy" aria-labelledby="hero-title">
    <div class="container container--wide">
      <p class="ss-mark"><span class="ss-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="ss-word">{CAMPAIGN_NAME}</span></p>
      <h1 id="hero-title">
        <span class="visually-hidden">{HERO_SENTENCE}</span>
        <span class="hero-line" aria-hidden="true">{HERO_WORDS.map((w, i) => (
          <><span class="hw"><span class="hw-i" style={`--i: ${i}`}>{w.bar ? <span class="m-bar">{w.text}</span> : w.text}</span></span>{i < HERO_WORDS.length - 1 ? ' ' : ''}</>
        ))}</span>
      </h1>
      <div class="m-hero-foot">
        <p class="m-lede">When your grades, degree and career depend on the people you may need to report, speaking&nbsp;up must be safe.</p>
        <div class="actions">
          <a class="btn btn-primary btn-lg" href={url('/take-action/')}>Support European Safeguards</a>
          <a class="btn btn-secondary btn-lg" href={url('/evidence/')}>See the Evidence</a>
        </div>
      </div>
    </div>
  </section>

  <Marquee />

  <section class="m-section on-paper" aria-labelledby="problem">
    <div class="container container--wide">
      <p class="m-folio"><span>The problem</span></p>
      <h2 id="problem" class="m-statement">
        <span class="visually-hidden">{KEY_SENTENCE}</span>
        <span aria-hidden="true">{STATEMENT_WORDS.map((w, i) => (
          <><span class="sw" style={`--i: ${i}`}>{w}</span>{' '}</>
        ))}<em class="m-bar sw" style={`--i: ${STATEMENT_WORDS.length}`}>{KEY_SENTENCE_ACCENT}</em></span>
      </h2>
      <a class="m-more" href={url('/problem/')}>Understand the problem <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="m-section on-navy" aria-labelledby="guarantees" data-reveal>
    <div class="container container--wide">
      <p class="m-folio"><span>Guarantees</span></p>
      <h2 id="guarantees" class="m-title">What must be guaranteed.</h2>
      <ol class="m-articles">
        {PRINCIPLES.map((p, i) => <li style={`--i: ${i}`}><span class="m-art-num" aria-hidden="true">{roman[i]}</span><div><h3>{p.title}</h3><p class="m-art-text">{p.text}</p></div></li>)}
      </ol>
      <a class="m-more" href={url('/standard/')}>See all {safeguardCount} safeguards <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="m-section on-paper" aria-labelledby="demands" data-reveal>
    <div class="container container--wide">
      <p class="m-folio"><span>Our demands</span></p>
      <h2 id="demands" class="m-title">What we want Europe to&nbsp;do.</h2>
      <ol class="m-demands">
        {DEMANDS.map((d, i) => <li style={`--i: ${i}`}><span class="m-dem-num" aria-hidden="true"><span>{i + 1}</span></span><div><h3>{d.title}</h3><p class="m-dem-text">{d.summary}</p></div></li>)}
      </ol>
      <a class="m-more" href={url('/demands/')}>Read our demands <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="m-section on-navy" aria-labelledby="evidence" data-reveal>
    <div class="container container--wide">
      <p class="m-folio"><span>Evidence</span></p>
      <div class="m-evidence">
        <div>
          <h2 id="evidence" class="m-title">The evidence.</h2>
          <p class="m-body">{pilotNames.length > 0 ? <>Research has started with {listFormat.format(pilotNames)}. {findingsLine}</> : 'Research has not started yet.'}</p>
          <div class="m-links">
            <a class="m-more" href={url('/evidence/')}>See the evidence <span aria-hidden="true">→</span></a>
            <a class="m-more" href={url('/europe/')}>Explore Europe <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <figure class="m-scope">
          <p class="m-scope-figure"><span class="m-scope-num"><span class="visually-hidden">{countries.length}</span><span aria-hidden="true" data-count={String(countries.length)}>{countries.length}</span></span><span class="m-scope-cap">EU Member States<br />in scope</span></p>
          <div class="m-grid" aria-hidden="true">
            {cells.map((on, i) => <span class="m-cell" data-on={on ? '' : undefined} style={`--i: ${i}`}></span>)}
          </div>
          <p class="visually-hidden">One square per Member State in scope. {started.length > 0 ? `Research has started in ${started.length}: ${startedNames}.` : 'Research has not started in any yet.'} {notStarted.length} not yet researched, which does not mean safeguards are absent.</p>
          <figcaption class="m-legend" aria-hidden="true">
            {started.length > 0 && <p class="m-key"><span class="m-sw" data-on=""></span><span>Research started ({startedNames})</span></p>}
            <p class="m-key"><span class="m-sw"></span><span>Not yet researched — no conclusion drawn</span></p>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="m-section m-action on-signal" id="safe-to-speak" aria-labelledby="act" data-reveal>
    <div class="container container--wide">
      <p class="m-folio"><span>Take action</span></p>
      <h2 id="act" class="m-triad">
        {triadLead.map((line, i) => <><span style={`--i: ${i}`}>{line}</span>{' '}</>)}
        <span class="m-ink-line" style={`--i: ${triadLead.length}`}><span class="m-ink">{triadLast}</span></span>
      </h2>
      <div class="actions">
        <a class="btn btn-primary btn-xl" href={url('/take-action/')}>Support European Safeguards</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import '../scripts/hero.ts';
  import '../scripts/reveal.ts';
  import '../scripts/marquee.ts';
</script>
