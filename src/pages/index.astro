---
import Base from '../layouts/Base.astro';
import { getCountries, getInstitutions, getRubric, hasFindings } from '../lib/data';
import { url } from '../lib/url';
import { CAMPAIGN_NAME, ORG_NAME, ORG_NAME_LEGAL, ORG_SEAT, PROGRAMME_NAME, STANDARD_NAME, DEMANDS } from '../lib/campaign';

const countries = getCountries();
const institutions = getInstitutions();
const rubric = getRubric();

const researchedCountries = countries.filter((c) => hasFindings(c.safeguards));
const researchedInstitutions = institutions.filter((i) => hasFindings(i.safeguards));
const results = [...countries, ...institutions].flatMap((r) => Object.values(r.safeguards)).filter((r) => r.result !== 'NR');
const verified = results.filter((r) => r.verification === 'verified').length;
const disputed = results.filter((r) => r.verification === 'disputed').length;
const safeguardCount = rubric.safeguards.length;

// AI assistance is disclosed as universal only when every record with findings says so.
const recordsWithFindings = [...researchedCountries, ...researchedInstitutions];
const allAiAssisted = recordsWithFindings.length > 0 && recordsWithFindings.every((r) => /\bAI\b/.test(r.research_method ?? ''));

const listFormat = new Intl.ListFormat('en', { style: 'long', type: 'conjunction' });
const withArticle = (name: string) => (/^(University|Academy|Institute)\b/.test(name) ? `the ${name}` : name);
const placeNames = [...researchedCountries.map((c) => c.name), ...researchedInstitutions.map((i) => withArticle(i.canonical_name))];

/**
 * The three workstreams. "now" is what exists in this repository today; "next" is
 * intent. They are rendered as separate lines so the two can never be read as one
 * claim. Nothing here describes a service the association does not operate.
 */
const WORK = [
  {
    title: STANDARD_NAME,
    now: `${safeguardCount} safeguards with observable criteria, published as v${rubric.methodology_version}, a draft for consultation.`,
    next: 'Independent review of the criteria before a stable version.',
    href: '/standard/',
    link: 'Read the Standard',
  },
  {
    title: 'Research',
    now: 'Published national and university rules read against the Standard, with the source and article behind every finding.',
    next: 'More Member States, and a human second reviewer for every finding.',
    href: '/evidence/',
    link: 'See the evidence',
  },
  {
    title: 'Advocacy',
    now: 'Three policy asks argued from the research, kept separate from it.',
    next: 'Minimum safeguards recognised across the European Higher Education Area.',
    href: '/demands/',
    link: 'Read the asks',
  },
];

/** Real routes only. Nothing here promises intake, advice or a mailing list. */
const PATHS = [
  { who: 'Researchers and reviewers', what: 'Check a finding against its source, or propose one with a locator and rationale.', href: '/contribute/', link: 'How to contribute' },
  { who: 'Institutions', what: 'Challenge a finding about your institution. Every record carries a right of reply.', href: '/corrections/', link: 'Right of reply' },
  { who: 'Students', what: 'See what your country and university have actually published, and what is missing.', href: '/europe/', link: 'Browse by country' },
  { who: 'Supporters', what: 'Read the asks and use them. There is no mailing list or petition to sign yet.', href: '/take-action/', link: 'Ways to help' },
];
---

<Base title="Home" campaign pageClass="home">
  {/* 1 — Who, what, and two actions that exist. */}
  <section class="hm-hero" aria-labelledby="hero-title">
    <div class="container container--wide">
      <div class="hm-hero-grid">
        <div>
          <h1 id="hero-title">Students should be safe to speak up.</h1>
          <p class="hm-lede">
            {ORG_NAME} works to make protection from retaliation, fair complaint procedures and
            effective remedies part of higher education across Europe.
          </p>
          <div class="hm-actions">
            <a class="btn btn-primary btn-lg" href={url('/about/')}>Explore our work</a>
            <a class="btn btn-secondary btn-lg" href={url('/evidence/')}>View our research</a>
          </div>
        </div>
        <p class="hm-provenance">
          An independent non-profit association based in {ORG_SEAT}, working across the European
          Higher Education Area. Not affiliated with the EU, any government or any university.
        </p>
      </div>
    </div>
  </section>

  {/* 2 — What we do, with now and next kept apart. */}
  <section class="hm-sec" aria-labelledby="work-h">
    <div class="container container--wide">
      <h2 id="work-h" class="hm-h2">What we do</h2>
      <ul class="hm-work" role="list">
        {WORK.map((w) => (
          <li>
            <h3>{w.title}</h3>
            <p class="hm-now"><span class="hm-tag">Now</span>{w.now}</p>
            <p class="hm-next"><span class="hm-tag hm-tag--next">Building</span>{w.next}</p>
            <a class="hm-link" href={url(w.href)}>{w.link}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* 3 — Where the research actually stands. Scope before scale. */}
  <section class="hm-sec hm-sec--panel on-navy" aria-labelledby="scope-h">
    <div class="container container--wide">
      <div class="hm-scope">
        <div>
          <h2 id="scope-h" class="hm-h2">Where the research stands</h2>
          <p class="hm-body">
            {placeNames.length > 0
              ? <>Research has begun in {listFormat.format(placeNames)}. It has not begun in the other {countries.length - researchedCountries.length} Member States, which says nothing about whether safeguards exist there.</>
              : <>Research has not begun yet.</>}
          </p>
          <a class="hm-link" href={url('/evidence/')}>See the evidence and its limits</a>
        </div>
        <dl class="hm-figures">
          <div>
            <dt>Findings published</dt>
            <dd>{results.length}</dd>
          </div>
          <div>
            <dt>Independently verified</dt>
            <dd>{verified}</dd>
          </div>
          <div>
            <dt>Under dispute</dt>
            <dd>{disputed}</dd>
          </div>
        </dl>
      </div>
      <p class="hm-caution">
        Every finding is provisional{allAiAssisted ? ' and AI-assisted' : ''}, and none has yet been
        checked by an independent human reviewer. A published rule is not proof of what happens in
        practice, and a safeguard we did not find is not a safeguard that is absent.
      </p>
    </div>
  </section>

  {/* 4 — Real paths, honest boundaries. */}
  <section class="hm-sec" aria-labelledby="paths-h">
    <div class="container container--wide">
      <h2 id="paths-h" class="hm-h2">Choose a path</h2>
      <ul class="hm-paths" role="list">
        {PATHS.map((p) => (
          <li>
            <h3>{p.who}</h3>
            <p>{p.what}</p>
            <a class="hm-link" href={url(p.href)}>{p.link}</a>
          </li>
        ))}
      </ul>
      <p class="hm-boundary">
        This website is not a reporting channel. {ORG_NAME} does not receive confidential cases,
        investigate individuals, give legal or psychological advice, or rank universities.
        {' '}<a href={url('/take-action/#not-a-reporting-service')}>Why, and where to go instead</a>
      </p>
    </div>
  </section>
</Base>
