---
import Base from '../../layouts/Base.astro';
import SafeguardScore from '../../components/SafeguardScore.astro';
import VerificationBadge from '../../components/VerificationBadge.astro';
import { getRubric, getCountries, RESULT_LABELS, type SafeguardDef, type ResultValue } from '../../lib/data';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return getRubric().safeguards.map((def) => ({ params: { safeguard: def.slug }, props: { def } }));
}
interface Props { def: SafeguardDef }
const { def } = Astro.props;
const countries = getCountries();
// Order: researched jurisdictions alphabetically first, then not-researched. Never sorted by score.
const rows = countries.map((c) => ({ c, r: c.safeguards[def.id] ?? { result: 'NR' as ResultValue } }));
const researched = rows.filter((x) => x.r.result !== 'NR');
const notResearched = rows.filter((x) => x.r.result === 'NR');
const order: ResultValue[] = ['3', '2', '1', '0', '?'];
---
<Base title={`${def.name} across EU countries`} crumbs={[{ label: 'Compare safeguards', href: '/compare/' }, { label: def.name }]}>
  <div class="container">
    <p class="eyebrow">{def.id} · National frameworks</p>
    <h1>{def.name} across EU countries</h1>
    <p class="lede">{def.question}</p>
    <div class="notice"><p>This page compares what <strong>national frameworks</strong> provide. Universities may provide stronger safeguards than their national framework requires. Countries are listed alphabetically, not ranked. <a href={url(`/standard/#${def.slug}`)}>See the rubric for this safeguard.</a></p></div>

    <h2>Distribution among researched countries</h2>
    {researched.length === 0 ? <p class="muted">No Member State has been researched for this safeguard yet.</p> : (
      <ul class="dist">
        {order.map((v) => <li><SafeguardScore result={v} compact /> {RESULT_LABELS[v]}: <strong>{researched.filter((x) => x.r.result === v).length}</strong></li>)}
      </ul>
    )}
    <p class="small muted">Not researched: {notResearched.length} of {countries.length} Member States.</p>

    <div class="table-wrap" style="margin-top:1.5rem">
      <table>
        <caption class="visually-hidden">{def.name} by country</caption>
        <thead><tr><th scope="col">Country</th><th scope="col">Result</th><th scope="col">Verification</th><th scope="col">Basis</th></tr></thead>
        <tbody>
          {[...researched, ...notResearched].map(({ c, r }) => (
            <tr>
              <th scope="row"><a href={url(`/countries/${c.slug}/#sg-${def.id.toLowerCase()}`)}>{c.name}</a></th>
              <td><SafeguardScore result={r.result} verification={r.verification} /></td>
              <td>{r.result === 'NR' ? <span class="muted">—</span> : <VerificationBadge status={r.verification} />}</td>
              <td class="small">{r.result === 'NR' ? <span class="muted">Not researched</span> : (r.locator ?? r.rationale?.slice(0, 120))}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</Base>
