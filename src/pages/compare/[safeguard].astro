---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Folio from '../../components/Folio.astro';
import SafeguardScore from '../../components/SafeguardScore.astro';
import VerificationBadge from '../../components/VerificationBadge.astro';
import SafeguardIcon from '../../components/SafeguardIcon.astro';
import CountryDots from '../../components/CountryDots.astro';
import { getRubric, getCountries, type SafeguardDef, type SafeguardResult, type ResultValue } from '../../lib/data';
import { url } from '../../lib/url';

// Below this many researched Member States a tally of results is too thin to mean anything
// and would read as a statistic, so results are then shown only row by row.
const MIN_COUNTRIES_FOR_TALLY = 5;

export function getStaticPaths() {
  return getRubric().safeguards.map((def) => ({ params: { safeguard: def.slug }, props: { def } }));
}
interface Props { def: SafeguardDef }
const { def } = Astro.props;
const countries = getCountries();
// Order: researched jurisdictions alphabetically first, then not-researched. Never sorted by score.
const rows = countries.map((c) => ({ c, r: c.safeguards[def.id] ?? { result: 'NR' as ResultValue } }));
const researched = rows.filter((x) => x.r.result !== 'NR');
const notResearched = rows.filter((x) => x.r.result === 'NR');
const provisional = researched.filter((x) => x.r.verification !== 'verified');
const n = researched.length;
const order: ResultValue[] = ['3', '2', '1', '0', '?'];
const tally = order.map((v) => {
  const matching = researched.filter((x) => x.r.result === v);
  return { v, count: matching.length, provisional: matching.filter((x) => x.r.verification !== 'verified').length };
});
const basis = (r: SafeguardResult) => {
  if (r.locator) return r.locator;
  const t = r.rationale ?? '';
  if (t.length <= 140) return t;
  const cut = t.lastIndexOf(' ', 140);
  return `${t.slice(0, cut > 0 ? cut : 140)}…`;
};
---
<Base
  title={`${def.name} across EU countries`}
  description={`${def.question} Results for national frameworks in EU Member States, one safeguard at a time. No ranking.`}
  campaign
>
  <PageHero crumbs={[{ label: 'Evidence', href: '/evidence/' }, { label: 'Compare safeguards', href: '/compare/' }, { label: def.name }]} kicker={`${def.id} · National frameworks`}>
    <SafeguardIcon slot="kicker-icon" id={def.id} size="1.25rem" />
    {def.name} across EU countries
    <Fragment slot="lede">{def.question}</Fragment>
    <Fragment slot="meta">
      <div class="statement">
        <p>National rules only; universities may provide more. Countries are alphabetical, not ranked. <a class="nowrap" href={url(`/standard/#${def.slug}`)}>Rubric for this safeguard →</a></p>
        {provisional.length > 0 && <p class="statement-prov"><strong>{provisional.length} of {n} {n === 1 ? 'result' : 'results'} provisional</strong>, not yet verified by a human reviewer.</p>}
        <details class="disclosure">
          <summary>What counts as national rules</summary>
          <p class="small">“National framework” here means legislation, regulations and national quality-assurance standards reviewed by ASE; each finding's sources show which is which. Accreditation standards are expectations, not statutory duties.</p>
        </details>
      </div>
    </Fragment>
  </PageHero>

  <section class="sec--dense" aria-labelledby="so-far">
    <div class="container">
      <Folio label="Results" dense />
      <h2 id="so-far">Results so far ({n} of {countries.length})</h2>
      {n === 0 ? (
        <p class="muted sec-note">No Member State has been researched for this safeguard yet.</p>
      ) : n < MIN_COUNTRIES_FOR_TALLY ? (
        <p class="muted sec-note">Too few countries for a comparison. Results are listed individually.</p>
      ) : (
        <div class="table-wrap table-wrap--narrow" tabindex="0" role="region" aria-labelledby="tally-cap">
          <table>
            <caption class="visually-hidden" id="tally-cap">Number of researched Member States by result</caption>
            <thead><tr><th scope="col">Result</th><th scope="col">Countries</th><th scope="col">Of which provisional</th></tr></thead>
            <tbody>
              {tally.map((t) => (
                <tr>
                  <th scope="row"><SafeguardScore result={t.v} verification={t.provisional > 0 ? 'needs_review' : undefined} /></th>
                  <td class="num">{t.count}</td>
                  <td class="num">{t.provisional}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {n > 0 && (
        <div class="table-wrap stack-table compare-table" tabindex="0" role="region" aria-labelledby="by-country">
          <table>
            <caption class="visually-hidden" id="by-country">{def.name}: results for researched Member States, alphabetical</caption>
            <thead><tr><th scope="col">Country</th><th scope="col">Result</th><th scope="col">Verification</th><th scope="col">Basis in the sources</th></tr></thead>
            <tbody>
              {researched.map(({ c, r }) => (
                <tr>
                  <th scope="row"><a href={url(`/countries/${c.slug}/#sg-${def.id.toLowerCase()}`)}>{c.name}</a></th>
                  <td data-label="Result"><span><SafeguardScore result={r.result} verification={r.verification} badgeShown /></span></td>
                  <td data-label="Verification"><span><VerificationBadge status={r.verification} short /></span></td>
                  <td data-label="Basis" class="small basis"><span>{basis(r)}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </section>

  <section class="sec--dense" aria-labelledby="not-researched">
    <div class="container">
      <Folio label="Not yet researched" dense />
      <h2 id="not-researched">Not researched yet ({notResearched.length} of {countries.length})</h2>
      <p class="missing-note">
        <svg class="info-glyph" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M8 7v4.5M8 4.6v.1" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" /></svg>
        <span>"Not yet researched" says nothing about whether a safeguard exists.</span>
      </p>
      <div class="dots-block">
        <CountryDots variant="labelled" filled={researched.map((x) => x.c.iso_code)} provisional={provisional.map((x) => x.c.iso_code)} context="for this safeguard" />
      </div>
      {notResearched.length > 0 && (
        <details class="disclosure">
          <summary>List of countries not yet researched</summary>
          <ul class="country-chips">
            {notResearched.map(({ c }) => <li><a href={url(`/countries/${c.slug}/`)}>{c.name}</a></li>)}
          </ul>
        </details>
      )}
    </div>
  </section>
</Base>
