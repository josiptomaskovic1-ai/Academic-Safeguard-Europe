---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Folio from '../components/Folio.astro';
import ActionBand from '../components/ActionBand.astro';
import { url, REPO_URL, repoFile } from '../lib/url';
import { CAMPAIGN_NAME } from '../lib/campaign';
import { getRubric } from '../lib/data';
const rubric = getRubric();
---
<Base title="About" description="About Academic Safeguard Europe: mission, independence, governance principles, limits of the research, and privacy." campaign>
  <PageHero tone="navy" crumbs={[{ label: 'About' }]} kicker="About ASE">
    Evidence about academic power, turned into a <span class="m-bar">European demand.</span>
    <Fragment slot="lede">An independent, open-source project that researches published student safeguards and campaigns to make them enforceable.</Fragment>
  </PageHero>

  <section class="sec on-paper" aria-labelledby="two-parts">
    <div class="container">
      <Folio label="Two layers" />
      <h2 id="two-parts" class="sec-title">One project, two layers.</h2>
      <div class="layers">
        <div>
          <h3>{CAMPAIGN_NAME}</h3>
          <p>The public campaign for European minimum safeguards.</p>
          <a class="m-more" href={url('/demands/')}>Our demands <span aria-hidden="true">→</span></a>
        </div>
        <div>
          <h3>The evidence base</h3>
          <p>Published rules assessed against the ASE Standard v{rubric.methodology_version}, sourced and correctable.</p>
          <a class="m-more" href={url('/evidence/')}>How the evidence works <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="sec on-paper" id="independence" aria-labelledby="independence-h">
    <div class="container">
      <Folio label="Governance" />
      <h2 id="independence-h" class="sec-title">Independent, open and correctable.</h2>
      <ul class="ruled-index ruled-index--3" role="list">
        <li><h3>Independent</h3><p>Not affiliated with the European Union, any government, quality-assurance agency, university or political party. No advertising or sponsors.</p></li>
        <li><h3>Neutral research</h3><p>Assumes neither that staff are dangerous nor that complaints are true. Campaign positions never change a finding.</p></li>
        <li><h3>Open</h3><p>Standard, method, data and code are public. Code <a href={repoFile('LICENSE')}>MIT</a>; data and texts <a href={repoFile('LICENSE-DATA.md')}>CC BY 4.0</a>.</p></li>
        <li><h3>Versioned</h3><p>Every method change is in the <a href={url('/methodology/changelog/')}>changelog</a>; every data change is a public commit.</p></li>
        <li><h3>Correctable</h3><p>Anyone can challenge a finding, and institutions have a <a href={url('/corrections/')}>right of reply</a>.</p></li>
      </ul>
    </div>
  </section>

  <section class="sec on-navy" id="scope" aria-labelledby="scope-h">
    <div class="container">
      <Folio label="Scope" />
      <h2 id="scope-h" class="sec-title">What ASE does, and does not do.</h2>
      <div class="accept accept--flush">
        <div class="accept-yes">
          <h3>Does</h3>
          <ul role="list">
            <li>Evaluate national laws and university rules</li>
            <li>Publish the evidence behind each finding</li>
            <li>Campaign for enforceable student safeguards</li>
          </ul>
        </div>
        <div class="accept-no">
          <h3>Does not</h3>
          <ul role="list">
            <li>Rate individual academics or judge whether allegations are true</li>
            <li>Accept complaints or investigate cases</li>
            <li>Give legal advice</li>
            <li>Rank universities or countries</li>
          </ul>
        </div>
      </div>
      <p class="c-note band-note">Need help with your own situation? Contact your student ombudsperson, complaints office, student union or a legal adviser. <a href={url('/take-action/#not-a-reporting-service')}>Why ASE cannot take individual cases</a></p>
    </div>
  </section>

  <section class="sec on-paper" id="limits" aria-labelledby="limits-h">
    <div class="container">
      <Folio label="Limits" />
      <div class="split">
        <h2 id="limits-h" class="sec-title">The limits of the research.</h2>
        <div class="reading">
          <p>A written policy does not show it works in practice, and not finding a provision does not prove a safeguard is missing.</p>
          <p>Findings stay provisional until an independent human reviewer has checked them.</p>
          <a class="m-more" href={url('/methodology/#11-known-limitations-of-v01')}>Known limitations <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="sec on-paper" id="privacy" aria-labelledby="privacy-h">
    <div class="container">
      <Folio label="Privacy" />
      <div class="split">
        <h2 id="privacy-h" class="sec-title">Privacy.</h2>
        <div>
          <p class="reading">No cookies, analytics, trackers, third-party scripts or fonts, no forms that send data to ASE, and no personal data in the research.</p>
          <details class="disclosure">
            <summary>Hosting, GitHub and referrer details</summary>
            <p class="small">The site is hosted on GitHub Pages. When you visit, GitHub, Inc. processes technical data such as your IP address to deliver and secure the site, and may keep it in logs. ASE has no access to these logs. Links to other websites send no referrer, so the sites you follow a link to are not told you came from ASE.</p>
            <p class="small">Correction requests and contributions are made through GitHub, which has its own <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">privacy statement</a>. Links to github.com take you to GitHub, where GitHub’s own terms and cookies apply. Contributors may use a pseudonymous account.</p>
          </details>
          <p class="small muted privacy-links">Security reports: <a href={repoFile('SECURITY.md')}>security policy</a>. Source code: <a href={REPO_URL}>GitHub</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <ActionBand id="close-title">
    Independent. Open. <span class="m-ink-line"><span class="m-ink">Correctable.</span></span>
    <Fragment slot="actions"><a class="btn btn-primary btn-xl" href={url('/take-action/')}>Support European Safeguards</a></Fragment>
  </ActionBand>
</Base>
