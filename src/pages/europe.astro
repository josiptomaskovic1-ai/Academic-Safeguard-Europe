---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Folio from '../components/Folio.astro';
import EuropeTileMap from '../components/EuropeTileMap.astro';
import ResearchStatus from '../components/ResearchStatus.astro';
import LastReviewed from '../components/LastReviewed.astro';
import StatBlock from '../components/StatBlock.astro';
import { getCountries, getInstitutions, getInstitutionsFor, coverage, hasFindings, countryCoverageWithInstitutions } from '../lib/data';
import { url } from '../lib/url';
const countries = getCountries();
const institutions = getInstitutions();
const results = [...countries, ...institutions].flatMap((r) => Object.values(r.safeguards)).filter((r) => r.result !== 'NR');
const withFindings = countries.filter((c) => hasFindings(c.safeguards)).length;
const stats = [
  { value: withFindings, label: withFindings === 1 ? 'Member State with findings' : 'Member States with findings' },
  { value: institutions.length, label: institutions.length === 1 ? 'institution profile' : 'institution profiles' },
  { value: results.filter((r) => r.verification === 'verified').length, label: 'verified findings' },
  { value: results.filter((r) => r.verification === 'needs_review').length, label: 'findings', tone: 'provisional' as const },
];
---
<Base title="Europe" description="Research status for all 27 EU Member States: which national frameworks and institutions StudentSafe Europe has researched so far, with provisional findings clearly marked." campaign>
  <PageHero crumbs={[{ label: 'Europe' }]} kicker={`Europe · ${countries.length} Member States`}>
    Europe
    <Fragment slot="lede">Research progress by Member State, one jurisdiction at a time. Shading shows how far research has got, not how well students are protected.</Fragment>
    <Fragment slot="aside"><StatBlock items={stats} label="Research coverage" class="explorer-stats hero-stats" /></Fragment>
  </PageHero>

  <section class="sec--dense" aria-labelledby="read-h">
    <div class="container">
      <Folio label="Map" dense />
      <div class="explorer">
        <div><EuropeTileMap withCounts /></div>
        <div class="explorer-aside">
          <h2 id="read-h">How to read the map</h2>
          <div class="statement">
            <p>Most Member States are not yet researched. <strong>“Not yet researched” never means that no safeguard exists.</strong></p>
          </div>
          <p class="muted sec-note">Select a country for its findings, evidence and verification status.</p>
          <ul class="ruled-links" role="list">
            <li><a href={url('/compare/')}>Compare one safeguard across countries <span aria-hidden="true">→</span></a></li>
            <li><a href={url('/institutions/')}>Institution profiles <span aria-hidden="true">→</span></a></li>
            <li><a href={url('/take-action/#researchers')}>Help research a country <span aria-hidden="true">→</span></a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="sec--dense" aria-label="All Member States, table">
    <div class="container">
      <Folio label="All Member States" dense />
      <h2 id="table-h">All Member States</h2>
      <p class="muted sec-note">Alphabetical, never ranked. Safeguards researched counts the national framework only.</p>
      <div class="table-wrap stack-table" tabindex="0" role="region" aria-labelledby="table-h">
        <table class="table--compact country-table">
          <caption class="visually-hidden">Research status by EU Member State. Safeguards researched counts the national framework only.</caption>
          <thead>
            <tr><th scope="col">Country</th><th scope="col">Research status</th><th scope="col">National safeguards researched</th><th scope="col">Institutions</th><th scope="col">Last reviewed</th></tr>
          </thead>
          <tbody>
            {countries.map((c) => {
              const cov = coverage(c.safeguards);
              const inst = getInstitutionsFor(c.iso_code).length;
              return (
                <tr data-status={c.research_status}>
                  <th scope="row" class="nowrap"><a href={url(`/countries/${c.slug}/`)}>{c.name}</a> <span class="source-id">{c.iso_code}</span></th>
                  <td data-label="Status"><span><ResearchStatus status={c.research_status} cov={countryCoverageWithInstitutions(c.iso_code)} /></span></td>
                  <td data-label="National safeguards" class="num"><span>{cov.researched === 0 ? <span class="muted" aria-hidden="true">—</span> : <>{cov.researched} of {cov.total}<span class="small muted"> · {cov.verified} verified, {cov.provisional} provisional</span></>}{cov.researched === 0 && <span class="visually-hidden">none</span>}</span></td>
                  <td data-label="Institutions" class="num"><span>{inst || <><span class="muted" aria-hidden="true">—</span><span class="visually-hidden">none</span></>}</span></td>
                  <td data-label="Last reviewed" class="small"><span>{c.last_reviewed ? <LastReviewed date={c.last_reviewed} /> : <><span class="muted" aria-hidden="true">—</span><span class="visually-hidden">not yet reviewed</span></>}</span></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Base>

<script>
  import '../scripts/reveal.ts';
</script>
