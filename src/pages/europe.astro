---
import Base from '../layouts/Base.astro';
import EuropeTileMap from '../components/EuropeTileMap.astro';
import ResearchStatus from '../components/ResearchStatus.astro';
import LastReviewed from '../components/LastReviewed.astro';
import { getCountries, getInstitutionsFor, coverage, countryCoverageWithInstitutions } from '../lib/data';
import { url } from '../lib/url';
const countries = getCountries();
---
<Base title="Europe" description="Research status for all 27 EU Member States: which national frameworks and institutions ASE has researched so far, with provisional findings clearly marked." crumbs={[{ label: 'Europe' }]}>
  <div class="container">
    <h1>European country explorer</h1>
    <p class="lede">All 27 EU Member States are represented. Each tile shows how far ASE's research has progressed. It does not show how well a country performs.</p>

    <div class="explorer" style="margin-top:2rem">
      <section aria-labelledby="map-h">
        <h2 id="map-h" class="visually-hidden">Map</h2>
        <EuropeTileMap withCounts />
      </section>
      <aside class="explorer-aside" aria-labelledby="read-h">
        <h2 id="read-h" style="margin-top:0">How to read the map</h2>
        <div class="notice" style="margin-top:0"><p>Most jurisdictions have not been researched yet. <strong>Missing data should not be interpreted as absence of safeguards.</strong></p></div>
        <p>Select a country to see its national framework, the evidence behind each finding, and any institutions researched. Every page shows whether its findings have been verified.</p>        <ul class="link-list">
          <li><a href={url('/compare/')}>Compare one safeguard across countries →</a></li>
          <li><a href={url('/institutions/')}>Institution profiles →</a></li>
          <li><a href={url('/contribute/')}>Help research a country →</a></li>
        </ul>
      </aside>
    </div>

    <section aria-labelledby="table-h" style="margin-top:3rem">
      <h2 id="table-h">All Member States</h2>
      <div class="table-wrap stack-table" tabindex="0" role="region" aria-labelledby="table-h">
        <table>
          <caption class="visually-hidden">Research status by EU Member State. Safeguards researched counts the national framework only.</caption>
          <thead>
            <tr><th scope="col">Country</th><th scope="col">Research status</th><th scope="col">National safeguards researched</th><th scope="col">Institutions</th><th scope="col">Last reviewed</th></tr>
          </thead>
          <tbody>
            {countries.map((c) => {
              const cov = coverage(c.safeguards);
              const inst = getInstitutionsFor(c.iso_code).length;
              return (
                <tr data-status={c.research_status}>
                  <th scope="row" class="nowrap"><a href={url(`/countries/${c.slug}/`)}>{c.name}</a> <span class="source-id">{c.iso_code}</span></th>
                  <td data-label="Status"><span><ResearchStatus status={c.research_status} cov={countryCoverageWithInstitutions(c.iso_code)} /></span></td>
                  <td data-label="National safeguards"><span>{cov.researched === 0 ? <span class="muted">—</span> : <>{cov.researched} of {cov.total}<span class="small muted"> · {cov.verified} verified, {cov.provisional} provisional</span></>}</span></td>
                  <td data-label="Institutions"><span>{inst || <span class="muted">—</span>}</span></td>
                  <td data-label="Last reviewed" class="small"><span><LastReviewed date={c.last_reviewed} /></span></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Base>
