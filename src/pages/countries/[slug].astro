---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Folio from '../../components/Folio.astro';
import ResearchStatus from '../../components/ResearchStatus.astro';
import LastReviewed from '../../components/LastReviewed.astro';
import MethodologyVersion from '../../components/MethodologyVersion.astro';
import ConfidenceLabel from '../../components/ConfidenceLabel.astro';
import SafeguardMatrix from '../../components/SafeguardMatrix.astro';
import SafeguardStrip from '../../components/SafeguardStrip.astro';
import SourceCitation from '../../components/SourceCitation.astro';
import InstitutionCard from '../../components/InstitutionCard.astro';
import CorrectionBanner from '../../components/CorrectionBanner.astro';
import NationalFramework from '../../components/NationalFramework.astro';
import ScopeIcon from '../../components/ScopeIcon.astro';
import DocTypeCounts from '../../components/DocTypeCounts.astro';
import { getCountries, getInstitutionsFor, coverage, countryCoverageWithInstitutions, localNameParts, type Country } from '../../lib/data';
import { url, repoFile } from '../../lib/url';

export function getStaticPaths() {
  return getCountries().map((country) => ({ params: { slug: country.slug }, props: { country } }));
}
interface Props { country: Country }
const { country: c } = Astro.props;
const cov = coverage(c.safeguards);
const institutions = getInstitutionsFor(c.iso_code);
const sourceIds = [...new Set(Object.values(c.safeguards).flatMap((r) => [...(r.source_ids ?? []), ...(r.sources_reviewed ?? [])]))];
const complete = cov.researched === cov.total && cov.verified === cov.total;
const localParts = c.local_name && c.local_name !== c.name ? localNameParts(c.iso_code, c.local_name) : [];
const researched = cov.researched > 0;
const gaps = c.evidence_gaps ?? [];
// Display grouping only: gap text is shown unchanged.
const unresolved = gaps.filter((g) => /^Unresolved:/i.test(g));
const otherGaps = gaps.filter((g) => !/^Unresolved:/i.test(g));
const nothingRecorded = !researched && institutions.length === 0 && gaps.length === 0 && sourceIds.length === 0;
const showDossier = researched && !!c.research_dossier && (cov.provisional > 0 || !!c.research_method);
const crumbs = [{ label: 'Europe', href: '/europe/' }, { label: c.name }];
---
<Base title={c.name} description={`Published safeguards against abuse of academic authority in ${c.name}: research status, findings and sources.`} campaign>
  <PageHero crumbs={crumbs} kicker={`EU Member State · ${c.iso_code}`} class="record-hero">
    {c.name}{localParts.length > 0 && <> <span class="h1-local">{localParts.map((p, i) => <>{i > 0 && ' / '}<span lang={p.lang}>{p.text}</span></>)}</span></>}
    <Fragment slot="meta">
      <dl class="facts">
        <div><dt>Status</dt><dd><ResearchStatus status={c.research_status} /></dd></div>
        {c.last_reviewed && <div><dt>Reviewed</dt><dd><LastReviewed date={c.last_reviewed} /></dd></div>}
        <div><dt>Method</dt><dd><MethodologyVersion version={c.methodology_version} /></dd></div>
        <div><dt>Coverage</dt><dd>{cov.researched}/{cov.total} researched</dd></div>
        {researched && <div class:list={{ 'is-prov': cov.provisional > 0 }}><dt>Verification</dt><dd>{cov.verified} verified{cov.provisional > 0 && ` · ${cov.provisional} provisional`}{cov.disputed > 0 && ` · ${cov.disputed} disputed`}</dd></div>}
      </dl>
    </Fragment>
    <Fragment slot="aside">
      <SafeguardStrip safeguards={c.safeguards} caption="National results, S01–S12" linkPrefix={researched ? '#sg-' : undefined} showKey={researched} />
      {!researched && <p class="small muted record-glance-note">All twelve are <strong>NR</strong>: not yet researched.</p>}
    </Fragment>
  </PageHero>

  <div class="container record-status">
    <div class="record-status-grid">
      {researched ? (
        <div class:list={['statement', { 'statement--provisional': cov.provisional > 0 }]}>
          {cov.provisional > 0 && <p><strong>{cov.provisional} of {cov.researched} national findings are provisional.</strong> {c.research_method ?? 'They have not yet been verified by a human second reviewer.'} They may change.</p>}
          {cov.provisional === 0 && c.research_method && <p><strong>Research method:</strong> {c.research_method}</p>}
          {!complete && <p>Research here is incomplete. <strong>Missing data is not absence of safeguards.</strong></p>}
          {(showDossier || gaps.length > 0) && (
            <ul class="link-row small">
              {showDossier && <li><a href={repoFile(c.research_dossier!)}>Research dossier</a></li>}
              {gaps.length > 0 && <li><a href="#gaps">Known gaps</a></li>}
            </ul>
          )}
        </div>
      ) : (
        <div class="statement">
          <p><strong>Not yet researched.</strong> Missing data is not absence of safeguards.</p>
          {nothingRecorded && <p class="muted">No institutions, sources or findings recorded yet. The whole jurisdiction is an evidence gap.</p>}
          <a class="m-more" href={url('/contribute/')}>Help research {c.name} <span aria-hidden="true">→</span></a>
        </div>
      )}

      <details class="disclosure record-meta">
        <summary>Record details</summary>
        <dl class="meta-list">
          <dt>Research status</dt><dd><ResearchStatus status={c.research_status} cov={countryCoverageWithInstitutions(c.iso_code)} /></dd>
          <dt>Last reviewed</dt><dd><LastReviewed date={c.last_reviewed} /></dd>
          <dt>Methodology</dt><dd><MethodologyVersion version={c.methodology_version} /></dd>
          <dt>Coverage</dt><dd>{cov.researched} of {cov.total} safeguards researched at national level · {cov.verified} verified · {cov.provisional} provisional{cov.disputed ? ` · ${cov.disputed} disputed` : ''}</dd>
          {researched && <><dt>Human verification</dt><dd>{cov.verified === 0 ? 'Not yet carried out' : `${cov.verified} of ${cov.researched} findings verified`}</dd></>}
          {c.confidence && <><dt title="Confidence in the evidence and interpretation, not a rating of the jurisdiction">Research confidence</dt><dd><ConfidenceLabel value={c.confidence} /></dd></>}
          <dt>Data file</dt><dd><a href={repoFile(`data/countries/${c.slug}.yml`)}><code>data/countries/{c.slug}.yml</code></a></dd>
        </dl>
      </details>
    </div>
  </div>

  {!researched && <NationalFramework country={c} />}

  <section class="sec--dense" aria-labelledby="matrix">
    <div class="container">
      <Folio label={researched ? 'Findings' : 'Safeguards'} dense />
      <h2 id="matrix">Safeguards in national rules</h2>
      {researched ? (
        <>
          <p class="muted sec-note">What national rules require of universities; universities may add more. Select a safeguard for its evidence.</p>
          <p class="caveat-line caveat-line--matrix">
            <ScopeIcon name="practice" size="1.15rem" />
            <span>These are published rules, not evidence of how they work in practice.</span>
          </p>
          <SafeguardMatrix safeguards={c.safeguards} correctionTarget={`country/${c.iso_code}`} />
        </>
      ) : (
        <>
          <p class="muted sec-note">No safeguard has been researched here. <strong>NR</strong> says nothing about whether safeguards exist. <a href={url('/standard/')}>See the 12 safeguard questions →</a></p>
          <details class="disclosure">
            <summary>Show all 12 safeguards</summary>
            <SafeguardMatrix safeguards={c.safeguards} correctionTarget={`country/${c.iso_code}`} />
          </details>
        </>
      )}
    </div>
  </section>

  {researched && <NationalFramework country={c} />}

  {(researched || institutions.length > 0) && (
    <section class="sec--dense" aria-labelledby="inst">
      <div class="container">
        <Folio label="Institutions" dense />
        <h2 id="inst">Institutions researched</h2>
        {institutions.length
          ? <div class="inst-rows">{institutions.map((i) => <InstitutionCard institution={i} showCountry={false} />)}</div>
          : <p class="muted">No institution in {c.name} has been researched yet.</p>}
      </div>
    </section>
  )}

  {(researched || gaps.length > 0) && (
    <section class="sec--dense" aria-labelledby="gaps-h">
      <div class="container" id="gaps">
        <Folio label="Evidence gaps" dense />
        <h2 id="gaps-h">Known evidence gaps{gaps.length > 0 && ` (${gaps.length})`}</h2>
        {gaps.length > 0 ? (
          <>
            <p class="muted sec-note">What this research round did not locate, open or resolve.</p>
            <details class="disclosure">
              <summary>Show {gaps.length} evidence {gaps.length === 1 ? 'gap' : 'gaps'}{unresolved.length > 0 && ` · ${unresolved.length} unresolved ${unresolved.length === 1 ? 'question' : 'questions'}`}</summary>
              {otherGaps.length > 0 && <ul class="gap-list prose">{otherGaps.map((g) => <li>{g}</li>)}</ul>}
              {unresolved.length > 0 && <><h3 class="subhead">Unresolved questions</h3><ul class="gap-list prose">{unresolved.map((g) => <li>{g}</li>)}</ul></>}
              {c.researcher_notes && (
                <details class="disclosure" id="notes">
                  <summary>Researcher notes</summary>
                  <p class="prose">{c.researcher_notes}</p>
                </details>
              )}
            </details>
          </>
        ) : (
          <>
            <p class="muted">No specific gaps recorded.</p>
            {c.researcher_notes && (
              <details class="disclosure" id="notes">
                <summary>Researcher notes</summary>
                <p class="prose">{c.researcher_notes}</p>
              </details>
            )}
          </>
        )}
      </div>
    </section>
  )}

  {sourceIds.length > 0 && (
    <section class="sec--dense" id="sources" aria-labelledby="src">
      <div class="container">
        <Folio label="Sources" dense />
        <h2 id="src">Sources ({sourceIds.length})</h2>
        <DocTypeCounts ids={sourceIds} />
        <details class="disclosure">
          <summary>Show all {sourceIds.length} citations</summary>
          <ul class="source-list prose">{sourceIds.map((id) => <li><SourceCitation id={id} full /></li>)}</ul>
        </details>
      </div>
    </section>
  )}

  <div class="sec--dense record-corrections"><div class="container"><CorrectionBanner target={`country/${c.iso_code}`} /></div></div>
</Base>
