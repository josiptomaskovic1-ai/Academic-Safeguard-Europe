---
/** A short gateway to the evidence. Full reasoning lives in the records and case study. */
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SafeguardScore from '../../components/SafeguardScore.astro';
import VerificationBadge from '../../components/VerificationBadge.astro';
import LastReviewed from '../../components/LastReviewed.astro';
import { getRubric, getCountries, getInstitutions, getInstitution, getSource, getEvidence, hasFindings } from '../../lib/data';
import { url } from '../../lib/url';

const rubric = getRubric();
const countries = getCountries();
const institutions = getInstitutions();
const croatia = countries.find((country) => country.slug === 'croatia');
const university = getInstitution('hr-unizg');
const safeguard = rubric.safeguards.find((item) => item.id === 'S02');
const finding = university?.safeguards.S02;
const source = getSource('hr-unizg-ethics-code-2007');
if (!croatia || !university || !safeguard || !finding || !source) {
  throw new Error('Evidence overview: the Croatia or University of Zagreb research record is missing.');
}
if (finding.result !== '1' || finding.verification !== 'needs_review') {
  throw new Error('Evidence overview: the featured S02 finding is no longer a provisional level 1.');
}
const QUOTE_HR = 'Na osobu koja je odbila uznemirivanje ili prijavila takvu vrstu ponašanja ne smije se vršiti nikakav pritisak.';
const QUOTE_EN = 'No pressure may be exerted on a person who rejected harassment or reported such behaviour.';
if (!finding.evidence?.includes(QUOTE_HR) || !finding.evidence?.includes(QUOTE_EN)) {
  throw new Error('Evidence overview: the featured quotation has changed in the source record.');
}
const allResults = [...countries, ...institutions].flatMap((record) => Object.values(record.safeguards));
const researched = allResults.filter((result) => result.result !== 'NR');
if (researched.some((result) => result.verification !== 'needs_review')) {
  throw new Error('Evidence overview: the all-provisional status must be revised.');
}
const verifiedCount = researched.filter((result) => result.verification === 'verified').length;
const researchedCountries = countries.filter((country) => hasFindings(country.safeguards)).length;
const schedule = rubric.safeguards.map((definition) => ({
  definition,
  national: croatia.safeguards[definition.id],
  university: university.safeguards[definition.id],
}));
const asAt = [croatia.last_reviewed, university.last_reviewed].filter(Boolean).sort().at(-1) ?? null;
const libraryIds = getEvidence().map((item) => item.id).join(' ');
---
<Base
  title="Evidence"
  description={`Explore ${researched.length} provisional findings from Croatia and the University of Zagreb. Follow each result to its source and reasoning.`}
  campaign
  pageClass="evidence evidence-brief"
>
  <section class="ev-brief-hero on-brand" aria-labelledby="page-title">
    <div class="ev-wrap">
      <Breadcrumbs crumbs={[{ label: 'Evidence' }]} />
      <div class="ev-brief-hero-grid">
        <div class="ev-brief-hero-copy">
          <h1 id="page-title">Every finding has a trail.</h1>
          <p>Start with published rules from Croatia and the University of Zagreb. Open any result to see the source and reasoning behind it.</p>
          <a class="btn btn-primary" href="#records">Explore the records</a>
        </div>
        <div class="ev-brief-status" aria-label="Current research status">
          <p><strong>{researched.length}</strong> findings <span>All provisional</span></p>
          <p><strong>{researchedCountries} / {countries.length}</strong> Member States researched</p>
          <p><strong>{verifiedCount}</strong> independently verified</p>
        </div>
      </div>
    </div>
  </section>

  <section class="ev-brief-records on-paper" id="records" aria-labelledby="records-title">
    <div class="ev-wrap">
      <div class="ev-brief-section-head">
        <h2 id="records-title">Choose a record.</h2>
        <p>National requirements and university rules answer different questions.</p>
      </div>
      <div class="ev-brief-routes">
        <a class="ev-brief-route ev-brief-route--national" href={url('/countries/croatia/')}>
          <span class="ev-brief-route-type">National framework</span>
          <strong>Croatia</strong>
          <span>{rubric.safeguards.length} safeguard findings · provisional</span>
          <span class="ev-brief-route-action">Open national record <span aria-hidden="true">↗</span></span>
        </a>
        <a class="ev-brief-route ev-brief-route--university" href={url('/institutions/hr-unizg/')}>
          <span class="ev-brief-route-type">University-wide rules</span>
          <strong>University of Zagreb</strong>
          <span>{rubric.safeguards.length} safeguard findings · provisional</span>
          <span class="ev-brief-route-action">Open university record <span aria-hidden="true">↗</span></span>
        </a>
      </div>
    </div>
  </section>

  <section class="ev-brief-feature" aria-labelledby="example-title">
    <div class="ev-wrap">
      <div class="ev-brief-section-head">
        <h2 id="example-title">One finding, up close.</h2>
        <p>{safeguard.id} · {safeguard.name} · University of Zagreb</p>
      </div>
      <div class="ev-brief-feature-grid">
        <div class="ev-brief-excerpt">
          <p class="ev-brief-small">English translation · <a href={url(`/sources/#${source.id}`)}>Code of Ethics, Art. 12(5)</a></p>
          <blockquote>{QUOTE_EN}</blockquote>
        </div>
        <div class="ev-brief-interpretation">
          <div class="ev-brief-result">
            <SafeguardScore result={finding.result} verification={finding.verification} badgeShown />
            <VerificationBadge status={finding.verification} short />
          </div>
          <p class="ev-brief-caveat">Whether the 2007 Code remains in force after the 2023 Statute, Art. 129(1), is unconfirmed.</p>
          <div class="ev-brief-feature-links">
            <a href={url('/evidence/inside-a-finding/#specimen')}>Inspect the full source trail</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="ev-brief-browse on-paper" aria-labelledby="browse-title">
    <div class="ev-wrap">
      <div class="ev-brief-section-head">
        <h2 id="browse-title">Browse all {researched.length} findings.</h2>
        <p>Each result opens its source and reasoning. All are provisional.</p>
      </div>
      <details class="ev-brief-disclosure" id="all">
        <summary><span>Open the {rubric.safeguards.length}-safeguard schedule</span><span class="ev-brief-disclosure-icon" aria-hidden="true"></span></summary>
        <div class="ev-table-wrap stack-table" role="region" aria-label="Schedule of findings" tabindex="0">
          <table class="ev-schedule">
            <caption class="visually-hidden">All {rubric.safeguards.length} safeguards for Croatia's national framework and the University of Zagreb. Every result is provisional.</caption>
            <thead>
              <tr>
                <th scope="col">Safeguard</th>
                <th scope="col"><a href={url('/countries/croatia/')}>Croatia</a><span class="ev-sub">national framework</span></th>
                <th scope="col"><a href={url('/institutions/hr-unizg/')}>University of Zagreb</a><span class="ev-sub">university-wide rules</span></th>
              </tr>
            </thead>
            <tbody>
              {schedule.map((row) => (
                <tr>
                  <th scope="row"><span class="ev-id">{row.definition.id}</span><a href={url(`/standard/#${row.definition.slug}`)}>{row.definition.name}</a></th>
                  <td data-label="Croatia, national framework"><a href={url(`/countries/croatia/#sg-${row.definition.id.toLowerCase()}`)}><SafeguardScore result={row.national?.result ?? 'NR'} verification={row.national?.verification} /></a></td>
                  <td data-label="University of Zagreb"><a href={url(`/institutions/hr-unizg/#sg-${row.definition.id.toLowerCase()}`)}><SafeguardScore result={row.university?.result ?? 'NR'} verification={row.university?.verification} /></a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
      <div class="ev-brief-extras">
        <a href={url('/evidence/library/')}>Evidence Library</a>
        <a href={url('/data/')}>Open data</a>
        <a href={url('/methodology/')}>Methodology</a>
      </div>
    </div>
  </section>

  <section class="ev-brief-close on-navy" aria-labelledby="limits-title">
    <div class="ev-wrap ev-brief-close-grid">
      <div>
        <h2 id="limits-title">Read the result, know its limits.</h2>
        <p>This examines published rules, not how an individual case was handled. Unresearched countries are not zeros, and these records are not an overall score.</p>
        <p class="ev-brief-dateline">Records reviewed <LastReviewed date={asAt} />.</p>
      </div>
      <div class="ev-brief-close-links">
        <a href={url('/contribute/#verify')}>Help verify a finding <span aria-hidden="true">↗</span></a>
        <a href={url('/corrections/#reply')}>Request a correction <span aria-hidden="true">↗</span></a>
        <a href={url('/take-action/#not-a-reporting-service')}>Need help with a case? <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <div hidden data-legacy-library={libraryIds} data-library-url={url('/evidence/library/')}></div>
  <script>
    // Focus the schedule as a region only when its content overflows horizontally.
    const scheduleRegion = document.querySelector<HTMLElement>('.ev-table-wrap');
    const disclosure = document.querySelector<HTMLDetailsElement>('.ev-brief-disclosure');
    if (scheduleRegion) {
      const syncScheduleFocus = () => {
        scheduleRegion.tabIndex = disclosure?.open && scheduleRegion.scrollWidth > scheduleRegion.clientWidth + 1 ? 0 : -1;
      };
      syncScheduleFocus();
      disclosure?.addEventListener('toggle', syncScheduleFocus);
      window.addEventListener('resize', syncScheduleFocus);
      document.fonts?.ready.then(syncScheduleFocus);
    }

    // Older /evidence/#item-id links addressed the Evidence Library.
    const holder = document.querySelector<HTMLElement>('[data-legacy-library]');
    let id = '';
    try { id = decodeURIComponent(location.hash.slice(1)); } catch { id = ''; }
    const ids = holder?.dataset.legacyLibrary?.split(' ') ?? [];
    if (holder && id && ids.includes(id) && !document.getElementById(id)) {
      location.replace(`${holder.dataset.libraryUrl}#${encodeURIComponent(id)}`);
    }
  </script>
</Base>
