---
import Base from '../../layouts/Base.astro';
import InstitutionCard from '../../components/InstitutionCard.astro';
import ScopeIcon from '../../components/ScopeIcon.astro';
import { getInstitutions } from '../../lib/data';
import { url } from '../../lib/url';
const institutions = getInstitutions();
---
<Base title="Institutions" description="Safeguard profiles of individual European universities, based on their published rules, with evidence and verification status. No rankings." crumbs={[{ label: 'Institutions' }]}>
  <div class="container">
    <h1>Institution profiles</h1>
    <p class="lede">Safeguards in each university's own published rules. No profile means not yet researched, not a judgement. No rankings.</p>
    <ul class="link-row page-links"><li><a href={url('/compare/')}>Compare one safeguard across countries →</a></li></ul>

    <h2 class="visually-hidden">Published profiles</h2>
    {institutions.length
      ? <div class="grid inst-grid page-grid">{institutions.map((i) => <InstitutionCard institution={i} />)}</div>
      : <p class="muted">No institution profiles have been published yet.</p>}

    <aside class="panel cta-panel" aria-labelledby="suggest">
      <span class="icon-frame" aria-hidden="true"><ScopeIcon name="contribute" size="1.3rem" /></span>
      <div>
        <h2 id="suggest">Suggest an institution</h2>
        <p>Know a university's rules? <a href={url('/contribute/')}>Research an institution →</a></p>
      </div>
    </aside>
  </div>
</Base>
