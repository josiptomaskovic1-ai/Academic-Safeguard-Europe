---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Folio from '../../components/Folio.astro';
import ResearchStatus from '../../components/ResearchStatus.astro';
import LastReviewed from '../../components/LastReviewed.astro';
import MethodologyVersion from '../../components/MethodologyVersion.astro';
import ConfidenceLabel from '../../components/ConfidenceLabel.astro';
import SafeguardMatrix from '../../components/SafeguardMatrix.astro';
import SafeguardStrip from '../../components/SafeguardStrip.astro';
import SourceCitation from '../../components/SourceCitation.astro';
import CorrectionBanner from '../../components/CorrectionBanner.astro';
import ScopeIcon from '../../components/ScopeIcon.astro';
import DocTypeCounts from '../../components/DocTypeCounts.astro';
import LayersDiagram from '../../components/LayersDiagram.astro';
import { getInstitutions, getCountry, coverage, primaryLang, type Institution } from '../../lib/data';
import { url, repoFile, externalUrl } from '../../lib/url';

export function getStaticPaths() {
  return getInstitutions().map((institution) => ({ params: { id: institution.id }, props: { institution } }));
}
interface Props { institution: Institution }
const { institution: i } = Astro.props;
const country = getCountry(i.country)!;
const cov = coverage(i.safeguards);
const sourceIds = [...new Set(Object.values(i.safeguards).flatMap((r) => [...(r.source_ids ?? []), ...(r.sources_reviewed ?? [])]))];
const typeLabel: Record<string, string> = { public_university: 'Public university', private_university: 'Private university', university_of_applied_sciences: 'University of applied sciences', polytechnic: 'Polytechnic', other: 'Higher-education institution' };
const file = `data/institutions/${i.country.toLowerCase()}/${i.id.slice(3)}.yml`;
const gaps = i.evidence_gaps ?? [];
// Display grouping only: gap text is shown unchanged.
const unresolved = gaps.filter((g) => /^Unresolved:/i.test(g));
const otherGaps = gaps.filter((g) => !/^Unresolved:/i.test(g));
const showDossier = !!i.research_dossier && (cov.provisional > 0 || !!i.research_method);
const links = showDossier || !!i.evidence_note || gaps.length > 0;
const crumbs = [{ label: 'Europe', href: '/europe/' }, { label: country.name, href: `/countries/${country.slug}/` }, { label: i.canonical_name }];
---
<Base title={i.canonical_name} description={`Published safeguards at ${i.canonical_name}: safeguard profile with evidence and sources.`} campaign>
  <PageHero crumbs={crumbs} kicker={`${typeLabel[i.institution_type]} · ${country.name}`} class="record-hero">
    {i.canonical_name}
    <Fragment slot="meta">
      {i.local_name && i.local_name !== i.canonical_name && <p class="h1-sub" lang={primaryLang(i.country)}>{i.local_name}</p>}
      <dl class="facts">
        <div><dt>Status</dt><dd><ResearchStatus status={i.research_status} kind="institution" /></dd></div>
        <div><dt>Reviewed</dt><dd><LastReviewed date={i.last_reviewed} /></dd></div>
        <div><dt>Method</dt><dd><MethodologyVersion version={i.methodology_version} /></dd></div>
        <div><dt>Coverage</dt><dd>{cov.researched}/{cov.total} researched</dd></div>
        <div class:list={{ 'is-prov': cov.provisional > 0 }}><dt>Verification</dt><dd>{cov.verified} verified{cov.provisional > 0 && ` · ${cov.provisional} provisional`}{cov.disputed > 0 && ` · ${cov.disputed} disputed`}</dd></div>
      </dl>
      <ul class="link-row record-links small">
        <li><a href={externalUrl(i.website)} rel="noopener">Official website <span class="muted">({i.website.replace(/^https?:\/\//, '').replace(/\/$/, '')})</span></a></li>
        <li><a href={url(`/countries/${country.slug}/`)}>National rules in {country.name} →</a></li>
      </ul>
    </Fragment>
    <Fragment slot="aside">
      <SafeguardStrip safeguards={i.safeguards} caption="Institution results, S01–S12" linkPrefix="#sg-" />
    </Fragment>
  </PageHero>

  <div class="container record-status">
    <div class="record-status-grid">
      <div class:list={['statement', { 'statement--provisional': cov.provisional > 0 }]}>
        {cov.provisional > 0 && <p><strong>{cov.provisional} of {cov.researched} findings are provisional.</strong> {i.research_method ?? 'They have not yet been verified by a human second reviewer.'} They may change.</p>}
        {cov.provisional === 0 && i.research_method && <p><strong>Research method:</strong> {i.research_method}</p>}
        <p class="statement-scope"><ScopeIcon name="practice" size="1.1rem" /><span><strong>University-wide rules only.</strong> Faculty rules may add protections. Formal policy is not proof of practice, and missing evidence is not proof of absence.</span></p>
        {links && (
          <ul class="link-row small">
            {showDossier && <li><a href={repoFile(i.research_dossier!)}>Research dossier</a></li>}
            {i.evidence_note && <li><a href="#summary">Read the summary</a></li>}
            {gaps.length > 0 && <li><a href="#gaps">Known gaps</a></li>}
          </ul>
        )}
      </div>

      <details class="disclosure record-meta">
        <summary>Record details</summary>
        <dl class="meta-list">
          <dt>Country</dt><dd><a href={url(`/countries/${country.slug}/`)}>{country.name}</a></dd>
          <dt>Official website</dt><dd><a href={externalUrl(i.website)} rel="noopener">{i.website.replace(/^https?:\/\//, '')}</a></dd>
          <dt>Research status</dt><dd><ResearchStatus status={i.research_status} kind="institution" cov={cov} /></dd>
          <dt>Last reviewed</dt><dd><LastReviewed date={i.last_reviewed} /></dd>
          <dt>Methodology</dt><dd><MethodologyVersion version={i.methodology_version} /></dd>
          <dt>Coverage</dt><dd>{cov.researched} of {cov.total} safeguards researched · {cov.verified} verified · {cov.provisional} provisional{cov.disputed ? ` · ${cov.disputed} disputed` : ''}</dd>
          {cov.researched > 0 && <><dt>Human verification</dt><dd>{cov.verified === 0 ? 'Not yet carried out' : `${cov.verified} of ${cov.researched} findings verified`}</dd></>}
          {i.confidence && <><dt title="Confidence in the evidence and interpretation, not a rating of the institution">Research confidence</dt><dd><ConfidenceLabel value={i.confidence} /></dd></>}
          <dt>Corrections</dt><dd>{{ none: 'No correction requests', open: 'Correction request open', resolved: 'Correction request resolved' }[i.correction_status]}</dd>
          <dt>Data file</dt><dd><a href={repoFile(file)}><code>{file}</code></a></dd>
        </dl>
      </details>
    </div>
  </div>

  {i.evidence_note && (
    <section class="sec--dense" aria-labelledby="summary">
      <div class="container">
        <Folio label="Summary" dense />
        <div class="split split--reading">
          <div>
            <h2 id="summary">Summary of published safeguards</h2>
            <div class="pull-panel"><p>{i.evidence_note}</p></div>
          </div>
          <LayersDiagram scope="institution" label="Where institution findings come from" />
        </div>
      </div>
    </section>
  )}

  <section class="sec--dense" aria-labelledby="matrix">
    <div class="container">
      <Folio label="Findings" dense />
      <h2 id="matrix">Safeguard profile</h2>
      <p class="muted sec-note">Select a safeguard for evidence, source and rationale.</p>
      <SafeguardMatrix safeguards={i.safeguards} correctionTarget={i.id} />
    </div>
  </section>

  {gaps.length > 0 && (
    <section class="sec--dense" aria-labelledby="gaps-h">
      <div class="container" id="gaps">
        <Folio label="Evidence gaps" dense />
        <h2 id="gaps-h">Known evidence gaps</h2>
        <details class="disclosure">
          <summary>Show {gaps.length} evidence gaps{unresolved.length > 0 && ` · ${unresolved.length} unresolved questions`}</summary>
          {otherGaps.length > 0 && <ul class="gap-list prose">{otherGaps.map((g) => <li>{g}</li>)}</ul>}
          {unresolved.length > 0 && <><h3 class="subhead">Unresolved questions</h3><ul class="gap-list prose">{unresolved.map((g) => <li>{g}</li>)}</ul></>}
        </details>
      </div>
    </section>
  )}

  <section class="sec--dense" id="sources" aria-labelledby="src">
    <div class="container">
      <Folio label="Sources" dense />
      <h2 id="src">Sources ({sourceIds.length})</h2>
      <DocTypeCounts ids={sourceIds} />
      <details class="disclosure">
        <summary>Show all {sourceIds.length} citations</summary>
        <ul class="source-list prose">{sourceIds.map((id) => <li><SourceCitation id={id} full /></li>)}</ul>
      </details>
    </div>
  </section>

  {i.replies?.length ? (
    <section class="sec--dense" aria-labelledby="replies">
      <div class="container">
        <Folio label="Reply" dense />
        <h2 id="replies">Statement of reply</h2>
        <p class="muted sec-note">The institution's own text, published unedited.</p>
        {i.replies.map((r) => <blockquote class="reading reply-text"><p>{r.text}</p><footer class="small muted">{r.submitted_by}, received {r.received}. Published unedited under the <a href={url('/corrections/')}>right of reply</a>.</footer></blockquote>)}
      </div>
    </section>
  ) : null}

  <div class="sec--dense record-corrections"><div class="container"><CorrectionBanner target={i.id} /></div></div>
</Base>

<script>
  import '../../scripts/reveal.ts';
</script>
