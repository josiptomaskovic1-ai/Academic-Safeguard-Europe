---
import Base from '../../layouts/Base.astro';
import OnThisPage from '../../components/OnThisPage.astro';
import { Content, frontmatter, getHeadings } from '../../../methodology/methodology-v0.1.md';
import { getRubric } from '../../lib/data';
import { repoFile, url } from '../../lib/url';
const rubric = getRubric();
const toc = [
  ...getHeadings().filter((h) => h.depth <= 2).map((h) => ({ slug: h.slug, text: h.text, depth: h.depth })),
  { slug: 'general-rules', text: 'General rules from the rubric', depth: 2 },
];
---
<Base title="Methodology" description="How Academic Safeguard Europe assigns, verifies and corrects safeguard findings." crumbs={[{ label: 'Methodology' }]}>
  <div class="container">
    <p class="eyebrow">Version {frontmatter.version} · {frontmatter.status}</p>
    <h1>{frontmatter.title}</h1>
    <p class="lede">How a score is determined, what evidence it needs, how it is verified, and how it can be challenged.</p>
    <div class="doc-grid">
      <OnThisPage items={toc} />
      <div class="doc-main">
        <ul class="link-row small" style="margin-bottom:1.5rem"><li><a href={url('/standard/#rubric')}>Rubric criteria</a></li><li><a href={repoFile('methodology/scoring-rubric.yml')}>scoring-rubric.yml</a></li><li><a href={repoFile('methodology/methodology-v0.1.md')}>Source text</a></li><li><a href={url('/methodology/changelog/')}>Changelog</a></li></ul>
        <div class="prose doc-body">
          <Content />
          <h2 id="general-rules">General rules from the rubric</h2>
          <ul>{rubric.general_rules.map((r) => <li>{r}</li>)}</ul>
        </div>
      </div>
    </div>
  </div>
</Base>
