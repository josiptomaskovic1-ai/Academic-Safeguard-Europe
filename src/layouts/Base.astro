---
import '../styles/global.css';
import { url, REPO_URL, repoFile } from '../lib/url';
import { getRubric } from '../lib/data';

interface Props {
  title: string;
  description?: string;
  crumbs?: { label: string; href?: string }[];
  /** Keep the page out of search indexes (used by the 404 page). */
  noindex?: boolean;
}
const { title, description = 'Academic Safeguard Europe evaluates published safeguards against abuse of academic authority, retaliation and procedural unfairness in European higher education.', crumbs, noindex = false } = Astro.props;
const fullTitle = title === 'Home' ? 'Academic Safeguard Europe' : `${title} · Academic Safeguard Europe`;
const rubric = getRubric();

const nav = [
  { href: '/europe/', label: 'Europe' },
  { href: '/institutions/', label: 'Institutions' },
  { href: '/compare/', label: 'Compare' },
  { href: '/standard/', label: 'Standard' },
  { href: '/methodology/', label: 'Methodology' },
  { href: '/evidence/', label: 'Evidence' },
  { href: '/corrections/', label: 'Corrections' },
  { href: '/about/', label: 'About' },
];
const current = Astro.url.pathname;
const isCurrent = (href: string) => current === url(href) || (href !== '/' && current.startsWith(url(href)));
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- GitHub Pages cannot send HTTP headers; frame-ancestors, report-uri and X-Frame-Options are not available via meta (see SECURITY.md). -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; upgrade-insecure-requests" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="referrer" content="no-referrer" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href={url('/')}>
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="4" fill="currentColor" style="color:var(--accent)"/><path d="M16 5l9 3.2v7.1c0 5.6-3.8 9.6-9 11.7-5.2-2.1-9-6.1-9-11.7V8.2z" fill="none" stroke="var(--surface)" stroke-width="2"/><path d="M11.5 13.5h9M11.5 17.5h9M11.5 21.5h5" stroke="var(--surface)" stroke-width="1.8"/></svg>
          <span><span class="brand-name">Academic Safeguard Europe</span><span class="brand-sub">Published safeguards · Evidence first</span></span>
        </a>
        <nav class="nav" aria-label="Main">
          <ul>
            {nav.map((n) => <li><a href={url(n.href)} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class:list={{ home: title === 'Home' }}>
      <div class="container">
        {crumbs && (
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            <ol>
              <li><a href={url('/')}>Home</a></li>
              {crumbs.map((c, i) => <li>{c.href && i < crumbs.length - 1 ? <a href={url(c.href)}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
            </ol>
          </nav>
        )}
      </div>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <h2>Project</h2>
            <ul>
              <li><a href={url('/about/')}>About and scope</a></li>
              <li><a href={url('/standard/')}>Standard v{rubric.methodology_version}</a></li>
              <li><a href={url('/methodology/')}>Methodology</a></li>
              <li><a href={url('/methodology/changelog/')}>Methodology changelog</a></li>
            </ul>
          </div>
          <div>
            <h2>Research</h2>
            <ul>
              <li><a href={url('/europe/')}>Country explorer</a></li>
              <li><a href={url('/compare/')}>Compare safeguards</a></li>
              <li><a href={url('/institutions/')}>Institutions</a></li>
              <li><a href={url('/evidence/')}>Evidence Library</a></li>
              <li><a href={url('/sources/')}>Source register</a></li>
            </ul>
          </div>
          <div>
            <h2>Participate</h2>
            <ul>
              <li><a href={url('/corrections/')}>Corrections and right of reply</a></li>
              <li><a href={url('/contribute/')}>Contribute research</a></li>
              <li><a href={url('/data/')}>Open data</a></li>
              <li><a href={REPO_URL}>Source code on GitHub</a></li>
            </ul>
          </div>
        </div>
        <div class="disclaimer small">
          <p>Independent project. Not affiliated with the European Union, any government, quality-assurance agency or university.</p>
          <p>ASE evaluates published rules. It does not rate individuals or judge allegations.</p>
          <p class="footer-facts">No cookies · No analytics · Code MIT · Data and texts <a href={repoFile('LICENSE-DATA.md')}>CC BY 4.0</a></p>
        </div>
      </div>
    </footer>
    <script is:inline src={url('/scripts/print.js')} defer></script>
    <script>
      // Open a closed <details> when a link targets it (or something inside it), e.g. #gaps or #sg-s03.
      // Progressive enhancement: without JavaScript the summary line is still where the anchor lands.
      const openForHash = () => {
        const id = decodeURIComponent(location.hash.slice(1));
        const el = id ? document.getElementById(id) : null;
        if (!el) return;
        let changed = false;
        const open = (d: Element | null) => {
          if (d instanceof HTMLDetailsElement && !d.open) { d.open = true; changed = true; }
        };
        open(el);
        el.querySelectorAll(':scope > details').forEach(open);
        for (let p = el.parentElement; p; p = p.parentElement) open(p);
        if (changed) el.scrollIntoView();
      };
      openForHash();
      window.addEventListener('hashchange', openForHash);
      document.addEventListener('click', (e) => {
        const a = (e.target as Element | null)?.closest?.('a[href*="#"]') as HTMLAnchorElement | null;
        if (a && a.pathname === location.pathname && a.hash === location.hash) requestAnimationFrame(openForHash);
      });
    </script>
  </body>
</html>
