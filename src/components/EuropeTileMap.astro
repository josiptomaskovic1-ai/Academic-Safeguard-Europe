---
// Tile-grid map: every Member State gets an equal tile, so small states stay usable
// and no country looks "bigger" in the evidence. Position approximates geography.
import { getCountries, COUNTRY_STATUS_LABELS } from '../lib/data';
import { url } from '../lib/url';
import ResearchStatus from './ResearchStatus.astro';

const GRID: Record<string, [col: number, row: number]> = {
  FI: [6, 1], SE: [5, 2], EE: [6, 2], IE: [1, 3], DK: [4, 3], LV: [6, 3],
  NL: [3, 4], DE: [4, 4], PL: [5, 4], LT: [6, 4],
  FR: [2, 5], BE: [3, 5], LU: [4, 5], CZ: [5, 5], SK: [6, 5],
  PT: [1, 6], ES: [2, 6], AT: [4, 6], SI: [5, 6], HU: [6, 6], RO: [7, 6],
  IT: [4, 7], HR: [5, 7], BG: [7, 7],
  MT: [4, 8], GR: [6, 8], CY: [7, 8],
};
const countries = getCountries();
const statuses = Object.keys(COUNTRY_STATUS_LABELS);
---
<div>
  <ul class="tilemap" aria-label="EU Member States arranged approximately by geography">
    {countries.map((c) => {
      const [col, row] = GRID[c.iso_code];
      return (
        <li style={`grid-column:${col};grid-row:${row}`}>
          <a href={url(`/countries/${c.slug}/`)} data-status={c.research_status} aria-label={`${c.name}: ${COUNTRY_STATUS_LABELS[c.research_status]}`} title={`${c.name} — ${COUNTRY_STATUS_LABELS[c.research_status]}`}>
            <span aria-hidden="true">{c.iso_code}</span>
          </a>
        </li>
      );
    })}
  </ul>
  <ul class="legend" aria-label="Legend">
    {statuses.map((s) => (
      <li>
        <span class="swatch tilemap-swatch" data-status={s} aria-hidden="true"></span>
        <ResearchStatus status={s} />
      </li>
    ))}
  </ul>
  <p class="small muted" style="margin-top:1rem">Shading shows how far research has progressed, not how well a country performs. A country that has not been researched is not a poor performer.</p>
</div>
<style>
  .tilemap-swatch[data-status='not_researched'] { background: repeating-linear-gradient(135deg, var(--surface) 0 4px, var(--surface-2) 4px 6px); border-style: dashed; }
  .tilemap-swatch[data-status='research_underway'] { background: var(--s0); }
  .tilemap-swatch[data-status='partially_researched'] { background: var(--s1); }
  .tilemap-swatch[data-status='national_framework_reviewed'] { background: var(--s2); }
  .tilemap-swatch[data-status='institution_research_available'] { background: var(--s3); }
</style>
