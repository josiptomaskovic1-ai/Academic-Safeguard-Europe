---
// Tile-grid map: every Member State gets an equal tile, so small states stay usable
// and no country looks "bigger" in the evidence. Position approximates geography.
// Status is never shown by fill alone: each tile carries the status glyph, and a text "P"
// marks tiles whose national or institutional findings are still provisional.
import { getCountries, countryCoverageWithInstitutions, COUNTRY_STATUS_LABELS } from '../lib/data';
import { url } from '../lib/url';
import ResearchStatus from './ResearchStatus.astro';

// Research started in Croatia and spreads outward, so each tile's delay is its
// distance from HR on this grid. Computed here, at build time, never in the browser.
const HR_CELL: [number, number] = [5, 7];
const rippleDelay = (col: number, row: number) =>
  Math.min(600, Math.round(Math.hypot(col - HR_CELL[0], row - HR_CELL[1]) * 45));

const GRID: Record<string, [col: number, row: number]> = {
  FI: [6, 1], SE: [5, 2], EE: [6, 2], IE: [1, 3], DK: [4, 3], LV: [6, 3],
  NL: [3, 4], DE: [4, 4], PL: [5, 4], LT: [6, 4],
  FR: [2, 5], BE: [3, 5], LU: [4, 5], CZ: [5, 5], SK: [6, 5],
  PT: [1, 6], ES: [2, 6], AT: [4, 6], SI: [5, 6], HU: [6, 6], RO: [7, 6],
  IT: [4, 7], HR: [5, 7], BG: [7, 7],
  MT: [4, 8], GR: [6, 8], CY: [7, 8],
};
interface Props {
  withCounts?: boolean;
  /** Legend lists only statuses that occur (homepage); the Europe page keeps the full scale. */
  compact?: boolean;
}
const { withCounts = false, compact = false } = Astro.props;
const countries = getCountries().map((c) => ({ c, cov: countryCoverageWithInstitutions(c.iso_code) }));
const countFor = (s: string) => countries.filter(({ c }) => c.research_status === s).length;
const statuses = Object.keys(COUNTRY_STATUS_LABELS).filter((s) => !compact || countFor(s) > 0);
const anyProvisional = countries.some(({ cov }) => cov.provisional > 0);
---
<div class="tilemap-block">
  <ul class="tilemap" role="list" data-reveal aria-label="EU Member States; larger layouts are arranged approximately by geography">
    {countries.map(({ c, cov }) => {
      const [col, row] = GRID[c.iso_code];
      const provisional = cov.provisional > 0;
      const text = `${c.iso_code} — ${c.name}: ${COUNTRY_STATUS_LABELS[c.research_status]}${provisional ? (cov.verified === 0 ? ', all findings provisional' : ', some findings provisional') : ''}`;
      return (
        <li style={`grid-column:${col};grid-row:${row};--d:${rippleDelay(col, row)}`}>
          <a href={url(`/countries/${c.slug}/`)} data-status={c.research_status} aria-label={text} title={text}>
            <span aria-hidden="true">{c.iso_code}</span>
            <ResearchStatus status={c.research_status} glyphOnly />
            {provisional && <span class="tile-flag" aria-hidden="true">P</span>}
          </a>
        </li>
      );
    })}
  </ul>
  <ul class="legend" role="list" aria-label="Legend">
    {statuses.map((s) => (
      <li>
        <span class="swatch tilemap-swatch" data-status={s} aria-hidden="true"></span>
        <ResearchStatus status={s} />
        {withCounts && <span class="legend-count">{countFor(s)}<span class="visually-hidden"> {countFor(s) === 1 ? 'country' : 'countries'}</span></span>}
      </li>
    ))}
    {anyProvisional && (
      <li>
        <span class="swatch flag-swatch" aria-hidden="true">P</span>
        <span>Contains provisional findings, not yet verified by a human reviewer</span>
      </li>
    )}
  </ul>
  <p class="small muted" style="margin-top:1rem">Shading shows research progress, not performance.</p>
</div>
<style>
  .tilemap-swatch[data-status='not_researched'] { background: repeating-linear-gradient(135deg, var(--surface) 0 4px, var(--surface-2) 4px 6px); border-style: dashed; }
  .tilemap-swatch[data-status='research_underway'] { background: var(--s0); }
  .tilemap-swatch[data-status='partially_researched'] { background: var(--s1); }
  .tilemap-swatch[data-status='national_framework_reviewed'] { background: var(--s2); }
  .tilemap-swatch[data-status='institution_research_available'] { background: var(--s3); border-color: var(--s3); }
</style>
