---
/**
 * ScopeIcon — small companion set to SafeguardIcon for describing what StudentSafe Europe does and does not do.
 * Same grid (24×24), stroke (1.75), caps and currentColor. Decorative: always pair with text.
 *
 * `negated` draws a diagonal strike through the glyph with a knockout gap, so "does not" is carried
 * by shape (and by the visible heading), not by colour. The knockout uses --icon-knockout, which
 * should match the background the icon sits on (defaults to --surface).
 */
export type ScopeIconName = 'legislation' | 'statutes' | 'safeguards' | 'evidence' | 'individuals' | 'allegations' | 'legal-advice' | 'practice' | 'ranking' | 'contribute' | 'correction' | 'data' | 'finding' | 'institution' | 'verify' | 'rubric' | 'correspondence' | 'privacy' | 'code' | 'licence' | 'mission' | 'balance' | 'download';
interface Props {
  name: ScopeIconName | string;
  negated?: boolean;
  size?: number | string;
  class?: string;
}
const { name, negated = false, size = 24, class: className } = Astro.props;

const PATHS: Record<ScopeIconName, string> = {
  // A proposed finding — a page carrying three result pips.
  finding: '<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4M8.5 9.5h7"/><path d="M8.75 13v4.5M12 13v4.5M15.25 13v4.5" stroke-width="2.25"/>',
  // A university — building with a door and a pediment.
  institution: '<path d="M3 20.5h18M5 20.5V10.5h14v10M2.5 10.5L12 4l9.5 6.5"/><path d="M10 20.5v-5h4v5M7.5 13v2M16.5 13v2"/>',
  // Independent verification — a second page behind the first, the front one checked.
  verify: '<path d="M4 17V3.5h8.5"/><path d="M7.5 6.5H17l2.5 2.5v11.5H7.5z"/><path d="M10.5 14.25l2 2 4-4.25"/>',
  // The rubric itself — a table of criteria.
  rubric: '<rect x="3.5" y="4" width="17" height="16" rx="1"/><path d="M3.5 9h17M3.5 14.5h17M9 4v16"/>',
  // Private correspondence — an envelope.
  correspondence: '<rect x="3" y="5.5" width="18" height="13" rx="1.5"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5"/>',
  // Privacy — a closed padlock.
  privacy: '<rect x="4.5" y="10.5" width="15" height="10" rx="1.5"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3M12 14.5v2.5"/>',
  // Open source code — angle brackets.
  code: '<path d="M8.5 7L3.5 12l5 5M15.5 7l5 5-5 5M13.5 4.5l-3 15"/>',
  // Licence — a page with a round seal.
  licence: '<path d="M6 3h8l4 4v5"/><path d="M14 3v4h4M6 3v18h6.5M8.5 10h6M8.5 13h3"/><circle cx="17" cy="16.5" r="3"/><path d="M15.5 19.2l-.5 2.8 2-1 2 1-.5-2.8"/>',
  // Mission — a compass needle.
  mission: '<circle cx="12" cy="12" r="8.5"/><path d="M15.5 8.5l-2 5-5 2 2-5z"/>',
  // Neutrality — a spirit level with its bubble centred.
  balance: '<rect x="2.5" y="8.5" width="19" height="7" rx="3.5"/><rect x="9.5" y="10.25" width="5" height="3.5" rx="1.75"/><path d="M12 4.5v2M12 17.5v2"/>',
  // Download.
  download: '<path d="M12 3.5v11M7.5 10l4.5 4.5 4.5-4.5M4 16.5v3.5h16v-3.5"/>',
  // Contribute research — a page with a plus mark.
  contribute: '<path d="M6 3h8l4 4v6"/><path d="M14 3v4h4"/><path d="M6 3v18h7"/><path d="M8.5 10h6M8.5 13.5h3.5"/><path d="M18 15.5v6M15 18.5h6"/>',
  // Corrections and right of reply — a page with a return arrow (the record is revisited, not overwritten).
  correction: '<path d="M6 3h8l4 4v5"/><path d="M14 3v4h4"/><path d="M6 3v18h5"/><path d="M8.5 10h6M8.5 13.5h3"/><path d="M21 21v-2.5a3 3 0 0 0-3-3h-4.5"/><path d="M15.5 13.5l-2 2 2 2"/>',
  // Open data — a database cylinder with a download arrow.
  data: '<ellipse cx="10" cy="5.5" rx="6.5" ry="2.5"/><path d="M3.5 5.5v12c0 1.4 2.9 2.5 6.5 2.5M16.5 5.5V11M3.5 11.5c0 1.4 2.9 2.5 6.5 2.5"/><path d="M18 13.5v7M15.5 18l2.5 2.5 2.5-2.5"/>',
  // National legislation / regulators — a civic building.
  legislation: '<path d="M3 9h18L12 3.5z"/><path d="M5.5 11.5v6M10 11.5v6M14 11.5v6M18.5 11.5v6M3 20.5h18"/>',
  // University statutes, regulations, codes — a stack of documents.
  statutes: '<path d="M8.5 3h8l3.5 3.5V18H8.5z"/><path d="M16.5 3v3.5H20"/><path d="M5 6.5V21h11"/><path d="M11 10.5h6M11 13.5h6"/>',
  // Whether rules provide the Standard's safeguards — shield with rule lines (brand echo).
  safeguards: '<path d="M12 3l7.5 2.75V11.5c0 4.75-3.2 8.1-7.5 9.5-4.3-1.4-7.5-4.75-7.5-9.5V5.75z"/><path d="M8.75 10h6.5M8.75 13.5h6.5"/>',
  // Evidence with exact source locations — a page with a bookmark ribbon.
  evidence: '<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4M8.5 10h7M8.5 13h3"/><path d="M13 13v6l1.75-1.4 1.75 1.4v-6"/>',
  // Individual academics — a name card without a face.
  individuals: '<rect x="3" y="5.5" width="18" height="13" rx="1.5"/><rect x="6" y="9" width="4.5" height="5" rx=".5"/><path d="M13 10h5M13 13h3.5"/>',
  // Allegations — a speech bubble.
  allegations: '<path d="M4 4.5h16v11h-8.5L7 19.5v-4H4z"/><path d="M8 8.5h8M8 11.5h5"/>',
  // Legal advice / representation — a briefcase.
  'legal-advice': '<rect x="3" y="7.5" width="18" height="12.5" rx="1.5"/><path d="M9 7.5V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2.5M3 12.5h18M11 12.5v2h2v-2"/>',
  // Implementation in practice — a gear (rules in operation).
  practice: '<circle cx="12" cy="12" r="5.75"/><circle cx="12" cy="12" r="2"/><path d="M12 3v3.25M12 17.75V21M3 12h3.25M17.75 12H21M5.64 5.64l2.3 2.3M16.06 16.06l2.3 2.3M5.64 18.36l2.3-2.3M16.06 7.94l2.3-2.3"/>',
  // Overall ranking — an ordered league list.
  ranking: '<path d="M10 6h10M10 12h10M10 18h10"/><path d="M4.25 5.25L5.5 4.5V8"/><path d="M4 10.75c.3-.6.8-.9 1.4-.9.7 0 1.2.45 1.2 1.05 0 .9-2.6 1.9-2.6 2.6h2.7"/><path d="M4 16.4c.3-.45.75-.65 1.3-.65.7 0 1.2.4 1.2.95 0 .5-.45.85-1.1.85.7 0 1.2.4 1.2 1 0 .6-.55 1-1.3 1-.55 0-1.05-.25-1.35-.7"/>',
};
// set:html only ever receives the constant markup above.
const body = Object.hasOwn(PATHS, name) ? PATHS[name as ScopeIconName] : '';
const strike = negated
  ? '<path d="M3.5 3.5l17 17" stroke="var(--icon-knockout, var(--surface))" stroke-width="3.75"/><path d="M3.5 3.5l17 17"/>'
  : '';
const dim = typeof size === 'number' ? `${size}px` : size;
---
<svg
  class:list={['scope-icon', { 'is-negated': negated }, className]}
  viewBox="0 0 24 24" width="24" height="24" style={`width:${dim};height:${dim}`}
  fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"
  aria-hidden="true" focusable="false"
  set:html={body + strike}
/>
