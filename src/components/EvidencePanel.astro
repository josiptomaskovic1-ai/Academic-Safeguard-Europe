---
import { getSource, DOC_TYPE_LABELS, type SafeguardResult, type SafeguardDef } from '../lib/data';
import SourceCitation from './SourceCitation.astro';
import ConfidenceLabel from './ConfidenceLabel.astro';
import VerificationBadge from './VerificationBadge.astro';
import LastReviewed from './LastReviewed.astro';
import { url } from '../lib/url';

interface Props { r: SafeguardResult; def: SafeguardDef }
const { r, def } = Astro.props;
const levelText = ['0', '1', '2', '3'].includes(r.result) ? def.levels[r.result as '0' | '1' | '2' | '3'] : null;
// The rubric requires secondary verification before a "0" is treated as final; say so explicitly when it is missing.
// Disputed zeros get the disputed notice instead, which is the more accurate description.
const unverifiedZero = r.result === '0' && r.verification !== 'verified' && r.verification !== 'disputed';
const docType = (id: string) => {
  const s = getSource(id);
  return s ? (DOC_TYPE_LABELS[s.document_type] ?? s.document_type) : null;
};
const compact = (text: string, max = 320) => {
  if (text.length <= max) return { text, shortened: false };
  const sentences = [...new Intl.Segmenter('en', { granularity: 'sentence' }).segment(text)].map(({ segment }) => segment.trim());
  let preview = '';
  for (const sentence of sentences) {
    const candidate = preview ? `${preview} ${sentence}` : sentence;
    if (preview && candidate.length > max) break;
    preview = candidate;
    if (preview.length >= 150) break;
  }
  if (preview.length > max * 1.35) {
    const wordBreak = preview.lastIndexOf(' ', max);
    preview = `${preview.slice(0, wordBreak > max * 0.7 ? wordBreak : max).trimEnd()}…`;
  }
  return { text: preview, shortened: preview !== text };
};
const rationale = r.rationale ? compact(r.rationale) : null;
const keySourceIds = r.source_ids ?? [];
const reviewedSourceIds = r.sources_reviewed ?? [];
const repeatedReviewed = reviewedSourceIds.filter((id) => keySourceIds.includes(id));
const additionalReviewed = reviewedSourceIds.filter((id) => !keySourceIds.includes(id));
---
<div class="evidence-panel">
  {r.result !== 'NR' && (
    <div class="evidence-status" role="group" aria-label="Finding status">
      <VerificationBadge status={r.verification} />
      <ConfidenceLabel value={r.confidence} />
    </div>
  )}
  <p class="evidence-question"><strong>Question</strong><span>{def.question}</span></p>

  {r.result === 'NR' && (
    <>
      <p>This safeguard has not been researched for this jurisdiction or institution yet. This says nothing about whether a safeguard exists. <a href={url('/contribute/')}>Help research it.</a></p>
      {def.notes && (
        <details class="disclosure evidence-record">
          <summary>Methodology note for this safeguard</summary>
          <p>{def.notes}</p>
        </details>
      )}
    </>
  )}

  {r.result !== 'NR' && (
    <>
      {unverifiedZero ? (
        <div class="notice provisional small"><p><strong>Not identified, provisional.</strong> The ASE rubric requires a second review before a "not identified" finding is treated as final. That review has not happened yet. This is not a finding that the safeguard is absent.</p></div>
      ) : r.verification === 'needs_review' && (
        <div class="notice provisional small"><p><strong>Provisional.</strong> Not yet verified by a human reviewer. May change.</p></div>
      )}
      {r.verification === 'disputed' && (
        <div class="notice disputed small"><p><strong>Disputed.</strong> A correction request or reviewer objection is open ({r.dispute_ids?.join(', ')}). See the <a href={url('/corrections/')}>corrections log</a>.</p></div>
      )}
      <dl class="evidence-primary">
        {r.evidence && <><dt>Finding</dt><dd>{r.evidence}</dd></>}
        {r.locator && <><dt>Source location</dt><dd>{r.locator}</dd></>}
        {rationale && <><dt>{rationale.shortened ? 'Rationale in brief' : 'Rationale'}</dt><dd>{rationale.text}</dd></>}
        {keySourceIds.length ? (
          <><dt>{keySourceIds.length > 1 ? 'Key citations' : 'Key citation'}</dt><dd><ul class="source-list">{keySourceIds.map((id) => <li>{docType(id) && <span class="doc-type">{docType(id)}</span>}<SourceCitation id={id} /></li>)}</ul></dd></>
        ) : null}
      </dl>

      <details class="disclosure evidence-record">
        <summary>Methodology notes and full record</summary>
        <dl class="evidence-secondary">
          {levelText && <><dt>Rubric level</dt><dd>{levelText}</dd></>}
          {r.result === '0' && <><dt>What 0 means</dt><dd>No qualifying provision was identified in the sources reviewed. This is not proof that no safeguard exists.</dd></>}
          {r.result === '?' && <><dt>What ? means</dt><dd>Research was carried out, but the available sources did not allow a responsible score.</dd></>}
          {rationale?.shortened && <><dt>Complete rationale</dt><dd>{r.rationale}</dd></>}
          {r.gaps && <><dt>Gaps and uncertainty</dt><dd>{r.gaps}</dd></>}
          {def.notes && <><dt>Methodology note</dt><dd>{def.notes}</dd></>}
          <dt>Reviewed</dt><dd><LastReviewed date={r.reviewed} /></dd>
          {reviewedSourceIds.length && (r.result === '0' || r.result === '?') ? (
            <>
              <dt>Complete sources reviewed ({reviewedSourceIds.length})</dt>
              <dd>
                {repeatedReviewed.length > 0 && (
                  <p class="reviewed-note">{repeatedReviewed.length === 1 ? 'The key citation shown above is' : `All ${repeatedReviewed.length} key citations shown above are`} included in this complete record.</p>
                )}
                {additionalReviewed.length > 0 && (
                  <ul class="source-list">{additionalReviewed.map((id) => <li>{docType(id) && <span class="doc-type">{docType(id)}</span>}<SourceCitation id={id} /></li>)}</ul>
                )}
              </dd>
            </>
          ) : null}
        </dl>
      </details>
    </>
  )}
</div>
