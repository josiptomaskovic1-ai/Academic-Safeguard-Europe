---
import { coverage, type Country } from '../lib/data';
import { url } from '../lib/url';
import ResearchStatus from './ResearchStatus.astro';
interface Props { country: Country }
const { country: c } = Astro.props;
const cov = coverage(c.safeguards);
---
<article class="card">
  <a class="stretched" href={url(`/countries/${c.slug}/`)}><h3>{c.name}</h3></a>
  <ResearchStatus status={c.research_status} />
  <p class="small muted">
    {cov.researched === 0
      ? 'No safeguards researched yet.'
      : `${cov.researched} of ${cov.total} safeguards researched · ${cov.verified} verified${cov.provisional ? ` · ${cov.provisional} provisional` : ''}`}
  </p>
</article>
