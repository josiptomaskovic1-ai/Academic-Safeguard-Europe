---
import { getRubric, type SafeguardResult } from '../lib/data';
import SafeguardScore from './SafeguardScore.astro';
import VerificationBadge from './VerificationBadge.astro';
import EvidencePanel from './EvidencePanel.astro';
import SafeguardIcon from './SafeguardIcon.astro';

interface Props { safeguards: Record<string, SafeguardResult>; idPrefix?: string }
const { safeguards, idPrefix = 'sg' } = Astro.props;
const { safeguards: defs } = getRubric();
---
<ul class="matrix">
  {defs.map((def) => {
    const r = safeguards[def.id] ?? { result: 'NR' };
    const badge = r.result !== 'NR' && r.verification !== 'verified';
    return (
      <li id={`${idPrefix}-${def.id.toLowerCase()}`}>
        <details>
          <summary>
            <span class="sg-id">{def.id}</span>
            <span class="sg-name"><SafeguardIcon id={def.id} size="1.25rem" class="sg-name-icon" /><span>{def.name}</span></span>
            <span class="sg-result">
              <SafeguardScore result={r.result} verification={r.verification} badgeShown={badge} />
              {badge && <VerificationBadge status={r.verification} short />}
            </span>
            <svg class="chev" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" /></svg>
          </summary>
          <div class="sg-body"><EvidencePanel r={r} def={def} /></div>
        </details>
      </li>
    );
  })}
</ul>
