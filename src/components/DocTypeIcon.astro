---
/**
 * DocTypeIcon — small line glyph for a source or Evidence Library document type.
 * Same grid and stroke as SafeguardIcon. Always decorative: the type label is shown next to it.
 */
interface Props { type: string; size?: number | string; class?: string }
const { type, size = 16, class: className } = Astro.props;
const PAGE = '<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4"/>';
const PATHS: Record<string, string> = {
  // civic building
  legislation: '<path d="M3 9h18L12 3.5z"/><path d="M5.5 11.5v6M10 11.5v6M14 11.5v6M18.5 11.5v6M3 20.5h18"/>',
  // numbered articles
  regulation: `${PAGE}<path d="M8.5 10.5h1M11.5 10.5h4M8.5 14h1M11.5 14h4M8.5 17.5h1M11.5 17.5h2.5"/>`,
  // stack of institutional documents
  statute: '<path d="M8.5 3h8l3.5 3.5V18H8.5z"/><path d="M16.5 3v3.5H20"/><path d="M5 6.5V21h11"/><path d="M11 10.5h6M11 13.5h6"/>',
  // page with a small shield
  policy: `${PAGE}<path d="M12 10l3 1.1v2.4c0 1.9-1.3 3.2-3 3.9-1.7-.7-3-2-3-3.9v-2.4z"/>`,
  // page with a ribbon
  code_of_ethics: `${PAGE}<path d="M8.5 10h7M8.5 13h3"/><path d="M13 13v6l1.75-1.4 1.75 1.4v-6"/>`,
  code_of_conduct: `${PAGE}<path d="M8.5 10h7M8.5 13h3"/><path d="M13 13v6l1.75-1.4 1.75 1.4v-6"/>`,
  // steps joined by a line
  procedure: '<circle cx="6" cy="5.5" r="2"/><circle cx="6" cy="18.5" r="2"/><path d="M6 7.5v9M11 5.5h9M11 12h7M11 18.5h9M6 12h2"/>',
  // signpost
  guidance: '<path d="M12 3v18M9 21h6"/><path d="M5 5.5h11l2.5 2.25L16 10H5z"/><path d="M19 12.5H8l-2.5 2.25L8 17h11z"/>',
  // page with text block
  report: `${PAGE}<path d="M8.5 10h7M8.5 13h7M8.5 16h7M8.5 19h4"/>`,
  // measuring rule
  standard: '<rect x="2.5" y="8" width="19" height="8" rx="1"/><path d="M6.5 8v3M10.5 8v4.5M14.5 8v3M18.5 8v4.5"/>',
  // open book
  research: '<path d="M3 5.5c3-1 6-.8 9 1 3-1.8 6-2 9-1v13c-3-1-6-.8-9 1-3-1.8-6-2-9-1z"/><path d="M12 6.5v13"/>',
  // three connected nodes
  network: '<circle cx="12" cy="5" r="2.25"/><circle cx="5" cy="18" r="2.25"/><circle cx="19" cy="18" r="2.25"/><path d="M11 7l-5 9M13 7l5 9M7.25 18h9.5"/>',
  other: PAGE,
};
// set:html only ever receives the constant markup above; own-property lookup keeps data values like "constructor" out.
const body = Object.hasOwn(PATHS, type) ? PATHS[type] : PATHS.other;
const dim = typeof size === 'number' ? `${size}px` : size;
---
<svg class:list={['doc-icon', className]} viewBox="0 0 24 24" width="24" height="24" style={`width:${dim};height:${dim}`}
  fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"
  aria-hidden="true" focusable="false" set:html={body} />
