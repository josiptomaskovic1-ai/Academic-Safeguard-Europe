---
/**
 * ScopePanel — "ASE examines / ASE does not" as two side-by-side cards with icons.
 * Replaces the homepage tick/cross lists. Defaults reproduce the current homepage wording,
 * shortened; pass `does` / `doesNot` to override. Satisfies the visible scope statement
 * requirement when used on the homepage (keep the "does not" column visible, never collapsed).
 */
import IconList from './IconList.astro';

interface Item { icon: string; text: string; detail?: string }
interface Props {
  does?: Item[];
  doesNot?: Item[];
  doesHeading?: string;
  doesNotHeading?: string;
  headingLevel?: 2 | 3 | 4;
  class?: string;
}
const {
  does = [
    { icon: 'legislation', text: 'National laws and regulator requirements' },
    { icon: 'statutes', text: 'University statutes, codes of ethics and complaint procedures' },
    { icon: 'safeguards', text: 'Whether those rules provide the 12 safeguards in the Standard' },
    { icon: 'evidence', text: 'The evidence behind each finding, with exact source locations' },
  ],
  doesNot = [
    { icon: 'individuals', text: 'Rate, name or rank individual academics' },
    { icon: 'allegations', text: 'Accept allegations or judge whether misconduct occurred' },
    { icon: 'legal-advice', text: 'Give legal advice or represent anyone' },
    { icon: 'practice', text: 'Claim a written policy works well in practice' },
    { icon: 'ranking', text: 'Produce an overall “safety” ranking of universities' },
  ],
  doesHeading = 'ASE examines',
  doesNotHeading = 'ASE does not',
  headingLevel = 3,
  class: className,
} = Astro.props;
const H = `h${headingLevel}` as 'h3';
---
<div class:list={['scope-panel', className]}>
  <section class="sp-card sp-card--does" aria-labelledby="sp-does">
    <H id="sp-does" class="sp-heading">{doesHeading}</H>
    <IconList items={does} tone="does" />
  </section>
  <section class="sp-card sp-card--doesnot" aria-labelledby="sp-doesnot">
    <H id="sp-doesnot" class="sp-heading">{doesNotHeading}</H>
    <IconList items={doesNot} tone="doesnot" />
  </section>
</div>

<style>
  .scope-panel { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); }
  .sp-card { border-radius: var(--radius); padding: 1.1rem 1.25rem 1.25rem; min-width: 0; }
  .sp-card--does { background: var(--surface); border: 1px solid var(--rule); border-top: 3px solid var(--accent); }
  .sp-card--doesnot { background: var(--paper); border: 1px dashed var(--control); border-top: 3px double var(--control); }
  .sp-heading { margin: 0 0 0.9rem; font-size: 1.15rem; }
  .sp-card--doesnot :global(.il-frame) { --icon-knockout: var(--paper); }
</style>
